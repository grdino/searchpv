			<column name="avg_sold_price_2br" type="numeric" />
			<column name="avg_sold_price_3br_plus" type="numeric" />
			<column name="median_sold_price_ft2" type="double precision" />
			<column name="median_sold_price_ft2_0br" type="double precision" />
			<column name="median_sold_price_ft2_1br" type="double precision" />
			<column name="median_sold_price_ft2_2br" type="double precision" />
			<column name="median_sold_price_ft2_3br_plus" type="double precision" />
