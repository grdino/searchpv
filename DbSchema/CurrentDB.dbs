		<function name="st_isvalidreason" id="4ce3a966-9094-4d75-912a-f8c36b69d7cd" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION public.st_isvalidreason(geometry, integer)
 RETURNS text
 LANGUAGE sql
 IMMUTABLE PARALLEL SAFE STRICT COST 10000
AS $function$
	SELECT CASE WHEN valid THEN 'Valid Geometry' ELSE reason END FROM (
		SELECT (public.ST_isValidDetail($1, $2)).*
	) foo
	$function$;]]></string>
		</function>
