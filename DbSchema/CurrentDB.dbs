			<column name="sold_quarter_start_dt" type="date" />
			<column name="sold_quarter_end_dt" type="date" />
			<column name="sold_year_start_dt" type="date" />
			<column name="sold_year_end_dt" type="date" />
			<column name="zone_nm" type="text" />
			<column name="area_nm" type="text" />
			<column name="community_nm" type="text" />
			<column name="development_nm" type="text" />
			<column name="building_nm" type="text" />
			<column name="prprty_fngrprnt_id" type="text" />
