 IMMUTABLE PARALLEL SAFE STRICT COST 50
AS $function$SELECT public.ST_Affine($1, 1, 0, 0, 0, cos($2), -sin($2), 0, sin($2), cos($2), 0, 0, 0)$function$;]]></string>
		</function>
		<function name="st_rotatey" id="18eb694e-5aa4-4c62-836a-a1f7f7595017" isSystem="false" params_known="n" >
