			<column name="load_ts" type="timestamp" />
		</view>
	</schema>
	<schema name="public" catalogname="postgres" >
		<comment><![CDATA[standard public schema]]></comment>
		<udt name="geometry_dump" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS (path integer[], geom geometry)]]></udt_script>
		</udt>
		<udt name="valid_detail" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS (valid boolean, reason character varying, location geometry)]]></udt_script>
		</udt>
		<table name="spatial_ref_sys" row_count="8500" spec="" >
			<column name="srid" type="integer" mandatory="y" />
			<column name="auth_name" type="varchar" length="256" />
			<column name="auth_srid" type="integer" />
			<column name="srtext" type="varchar" length="2048" />
			<column name="proj4text" type="varchar" length="2048" />
			<index name="spatial_ref_sys_pkey" unique="PRIMARY_KEY" >
				<column name="srid" />
			</index>
			<constraint name="spatial_ref_sys_srid_check" type="CHECK" options="" >
				<string><![CDATA[srid > 0) AND (srid <= 998999]]></string>
			</constraint>
		</table>
		<view name="active_listing" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS SELECT invntry_snap_ky,
    invntry_snap_date_ky,
    lstng_ky,
    prprty_ky,
    zone_name,
    area_name,
    community_name,
    development_name,
    prprty_type,
    prprty_type_cd,
    market_type,
    mls,
    address,
    development,
    beds,
    baths,
    sqft,
    sqm,
    lot_sqft,
    lot_sqm,
    original_price,
    current_price,
    price_changes,
    price_change_amount,
    price_change_percent,
    price_per_sqft,
    price_per_sqm,
    dom,
    lstng_agncy_ds,
    lstng_agnt_nm,
    lstng_co_agnt_nm,
    year_blt_dt,
    flr_nb,
    prmy_view_nm,
    scndry_view_nm,
    lat_nb,
    long_nb,
    bldng_ds,
    unit_id,
    tax_id,
    prprty_fngrprnt_id,
    load_dt,
    data_current_as_of
   FROM rpt.active_listing]]></view_script>
			<column name="invntry_snap_ky" type="bigint" />
