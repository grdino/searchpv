		<function name="_postgis_join_selectivity" id="1a1ceba8-838d-43a6-bfe9-a3c09cf1fec0" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION public._postgis_join_selectivity(regclass, text, regclass, text, text DEFAULT '2'::text)
 RETURNS double precision
 LANGUAGE c
 PARALLEL SAFE STRICT
AS '$libdir/postgis-3', $function$_postgis_gserialized_joinsel$function$;]]></string>
