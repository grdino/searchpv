		<function name="st_linefromtext" id="a6e635e8-9895-4380-b8d0-78b8a7de6573" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION public.st_linefromtext(text, integer)
