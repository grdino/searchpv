	<schema name="rpt" catalogname="postgres" >
		<view name="active_listing" >
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH latest_snapshot AS (
         SELECT max(invntry_snap.invntry_snap_date_ky) AS invntry_snap_date_ky
           FROM dw.invntry_snap), price_changes AS (
         SELECT prc_hstry.lstng_ky,
            count(*) AS price_changes
           FROM dw.prc_hstry
          GROUP BY prc_hstry.lstng_ky)
 SELECT s.invntry_snap_ky,
    s.invntry_snap_date_ky,
    l.lstng_ky,
    p.prprty_ky,
    p.zone_ds AS zone_name,
    p.area_ds AS area_name,
    p.cmnty_ds AS community_name,
    p.dvlpmnt_ds AS development_name,
    p.prprty_type,
    l.prprty_type_cd,
        CASE
            WHEN s.pre_cnstrctn_fl THEN 'Pre-Construction'::text
            ELSE 'Resale'::text
        END AS market_type,
    l.lstng_nb AS mls,
    p.adrs_ds AS address,
    p.dvlpmnt_ds AS development,
    l.bdrm_nb AS beds,
    (COALESCE(l.full_bthrm_nb, (0)::numeric) + (COALESCE(l.half_bthrm_nb, (0)::numeric) * 0.5)) AS baths,
    l.ft2_cnstrctn_nb AS sqft,
    l.m2_cnstrctn_nb AS sqm,
    l.ft2_lot_nb AS lot_sqft,
    l.m2_lot_nb AS lot_sqm,
    s.orgnl_list_prc_am AS original_price,
    s.snap_list_prc_am AS current_price,
    COALESCE(pc.price_changes, (0)::bigint) AS price_changes,
        CASE
            WHEN ((s.orgnl_list_prc_am IS NOT NULL) AND (s.snap_list_prc_am IS NOT NULL)) THEN (s.snap_list_prc_am - s.orgnl_list_prc_am)
            ELSE NULL::numeric
        END AS price_change_amount,
        CASE
            WHEN (s.orgnl_list_prc_am > (0)::numeric) THEN round((((s.snap_list_prc_am - s.orgnl_list_prc_am) / s.orgnl_list_prc_am) * (100)::numeric), 2)
            ELSE NULL::numeric
        END AS price_change_percent,
    s.prc_ft2_qt AS price_per_sqft,
    s.prc_m2_qt AS price_per_sqm,
    s.dom_qt AS dom,
    l.lstng_agncy_ds,
    l.lstng_agnt_nm,
    l.lstng_co_agnt_nm,
    l.year_blt_dt,
    l.flr_nb,
    l.prmy_view_nm,
    l.scndry_view_nm,
    p.lat_nb,
    p.long_nb,
    p.bldng_ds,
    p.unit_id,
    p.tax_id,
    p.prprty_fngrprnt_id,
    p.load_dt,
    s.run_ts AS data_current_as_of
   FROM ((((dw.invntry_snap s
     JOIN latest_snapshot ls ON ((s.invntry_snap_date_ky = ls.invntry_snap_date_ky)))
     JOIN dw.lstng l ON ((s.lstng_ky = l.lstng_ky)))
     JOIN dw.prprty p ON ((s.prprty_ky = p.prprty_ky)))
     LEFT JOIN price_changes pc ON ((s.lstng_ky = pc.lstng_ky)))
  WHERE (s.stts_cd = 'A'::text)]]></view_script>
			<column name="invntry_snap_ky" type="bigint" />
			<column name="invntry_snap_date_ky" type="integer" />
			<column name="lstng_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="zone_name" type="text" />
			<column name="area_name" type="text" />
			<column name="community_name" type="text" />
			<column name="development_name" type="text" />
			<column name="prprty_type" type="text" />
			<column name="prprty_type_cd" type="text" />
			<column name="market_type" type="text" />
			<column name="mls" type="bigint" />
			<column name="address" type="text" />
			<column name="development" type="text" />
			<column name="beds" type="numeric" />
			<column name="baths" type="numeric" />
			<column name="sqft" type="numeric" />
			<column name="sqm" type="numeric" />
			<column name="lot_sqft" type="numeric" />
			<column name="lot_sqm" type="numeric" />
			<column name="original_price" type="numeric" />
			<column name="current_price" type="numeric" />
			<column name="price_changes" type="bigint" />
			<column name="price_change_amount" type="numeric" />
			<column name="price_change_percent" type="numeric" />
			<column name="price_per_sqft" type="numeric" />
			<column name="price_per_sqm" type="numeric" />
			<column name="dom" type="integer" />
			<column name="lstng_agncy_ds" type="text" />
			<column name="lstng_agnt_nm" type="text" />
			<column name="lstng_co_agnt_nm" type="text" />
			<column name="year_blt_dt" type="integer" />
			<column name="flr_nb" type="text" />
			<column name="prmy_view_nm" type="text" />
			<column name="scndry_view_nm" type="text" />
			<column name="lat_nb" type="numeric" />
			<column name="long_nb" type="numeric" />
			<column name="bldng_ds" type="text" />
			<column name="unit_id" type="text" />
			<column name="tax_id" type="text" />
			<column name="prprty_fngrprnt_id" type="text" />
			<column name="load_dt" type="date" />
			<column name="data_current_as_of" type="timestamp" />
		</view>
		<view name="area_listing_drilldown" >
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH latest_snapshot AS (
         SELECT max(invntry_snap.invntry_snap_date_ky) AS invntry_snap_date_ky
           FROM dw.invntry_snap), base_inventory AS (
         SELECT p.zone_ds AS zone_name,
            p.area_ds AS area_name,
            l.lstng_nb,
                CASE
                    WHEN (i.pre_cnstrctn_fl = true) THEN 'pre_construction'::text
                    ELSE 'resale'::text
                END AS market_segment,
                CASE
                    WHEN (lower(COALESCE(l.prprty_type_cd, ''::text)) ~~ '%house%'::text) THEN 'houses'::text
                    ELSE 'condos'::text
                END AS property_type_segment,
                CASE
                    WHEN (COALESCE(l.bdrm_nb, (0)::numeric) = (0)::numeric) THEN '0br'::text
                    WHEN (l.bdrm_nb = (1)::numeric) THEN '1br'::text
                    WHEN (l.bdrm_nb = (2)::numeric) THEN '2br'::text
                    ELSE '3br_plus'::text
                END AS bedroom_segment,
                CASE
                    WHEN (i.stts_cd = 'A'::text) THEN 'active'::text
                    WHEN (i.stts_cd = 'P'::text) THEN 'pending'::text
                    ELSE NULL::text
                END AS metric_group
           FROM (((dw.invntry_snap i
             JOIN latest_snapshot ls ON ((i.invntry_snap_date_ky = ls.invntry_snap_date_ky)))
             JOIN dw.lstng l ON ((i.lstng_ky = l.lstng_ky)))
             JOIN dw.prprty p ON ((l.prprty_ky = p.prprty_ky)))
          WHERE ((i.stts_cd = ANY (ARRAY['A'::text, 'P'::text])) AND (p.zone_ds IS NOT NULL) AND (p.area_ds IS NOT NULL) AND (l.lstng_nb IS NOT NULL))), base_sales AS (
         SELECT p.zone_ds AS zone_name,
            p.area_ds AS area_name,
            l.lstng_nb,
                CASE
                    WHEN (s.pre_cnstrctn_fl = true) THEN 'pre_construction'::text
                    ELSE 'resale'::text
                END AS market_segment,
                CASE
                    WHEN (lower(COALESCE(l.prprty_type_cd, ''::text)) ~~ '%house%'::text) THEN 'houses'::text
                    ELSE 'condos'::text
                END AS property_type_segment,
                CASE
                    WHEN (COALESCE(l.bdrm_nb, (0)::numeric) = (0)::numeric) THEN '0br'::text
                    WHEN (l.bdrm_nb = (1)::numeric) THEN '1br'::text
                    WHEN (l.bdrm_nb = (2)::numeric) THEN '2br'::text
                    ELSE '3br_plus'::text
                END AS bedroom_segment,
            'sold_12mo'::text AS metric_group
           FROM ((dw.clsd_sale s
             JOIN dw.lstng l ON ((s.lstng_ky = l.lstng_ky)))
             JOIN dw.prprty p ON ((l.prprty_ky = p.prprty_ky)))
          WHERE ((to_date((s.sold_date_ky)::text, 'YYYYMMDD'::text) >= (CURRENT_DATE - '1 year'::interval)) AND (p.zone_ds IS NOT NULL) AND (p.area_ds IS NOT NULL) AND (l.lstng_nb IS NOT NULL))), base_rows AS (
         SELECT base_inventory.zone_name,
            base_inventory.area_name,
            base_inventory.lstng_nb,
            base_inventory.market_segment,
            base_inventory.property_type_segment,
            base_inventory.bedroom_segment,
            base_inventory.metric_group
           FROM base_inventory
        UNION ALL
         SELECT base_sales.zone_name,
            base_sales.area_name,
            base_sales.lstng_nb,
            base_sales.market_segment,
            base_sales.property_type_segment,
            base_sales.bedroom_segment,
            base_sales.metric_group
           FROM base_sales), expanded_rows AS (
         SELECT b.zone_name,
            b.area_name,
            m.market_segment,
            pt.property_type_segment,
            b.metric_group,
            br.bedroom_segment,
            b.lstng_nb
           FROM (((base_rows b
             CROSS JOIN LATERAL ( VALUES (b.market_segment), ('all'::text)) m(market_segment))
             CROSS JOIN LATERAL ( VALUES (b.property_type_segment), ('all'::text)) pt(property_type_segment))
             CROSS JOIN LATERAL ( VALUES (b.bedroom_segment), ('all'::text)) br(bedroom_segment)))
 SELECT zone_name,
    lower(regexp_replace(regexp_replace(translate(zone_name, 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS zone_slug,
    area_name,
    lower(regexp_replace(regexp_replace(translate(area_name, 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS area_slug,
    market_segment,
    property_type_segment,
    metric_group,
    bedroom_segment,
    count(*) AS listing_count,
    string_agg((lstng_nb)::text, ','::text ORDER BY lstng_nb DESC) AS listing_ids
   FROM expanded_rows
  GROUP BY zone_name, area_name, market_segment, property_type_segment, metric_group, bedroom_segment]]></view_script>
			<column name="zone_name" type="text" />
			<column name="zone_slug" type="text" />
			<column name="area_name" type="text" />
			<column name="area_slug" type="text" />
			<column name="market_segment" type="text" />
			<column name="property_type_segment" type="text" />
			<column name="metric_group" type="text" />
			<column name="bedroom_segment" type="text" />
			<column name="listing_count" type="bigint" />
			<column name="listing_ids" type="text" />
		</view>
		<view name="area_snapshot" >
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS SELECT zone_name,
    zone_slug,
    area_name,
    area_slug,
    snapshot_date,
    market_segment,
    property_type_segment,
    min(sales_period_start) AS sales_period_start,
    max(sales_period_end) AS sales_period_end,
    sum(active_count) AS active_count,
    sum(pending_count) AS pending_count,
    sum(active_0br) AS active_0br,
    sum(active_1br) AS active_1br,
    sum(active_2br) AS active_2br,
    sum(active_3br_plus) AS active_3br_plus,
    sum(pending_0br) AS pending_0br,
    sum(pending_1br) AS pending_1br,
    sum(pending_2br) AS pending_2br,
    sum(pending_3br_plus) AS pending_3br_plus,
    sum(sales_12mo) AS sales_12mo,
    sum(sales_0br_12mo) AS sales_0br_12mo,
    sum(sales_1br_12mo) AS sales_1br_12mo,
    sum(sales_2br_12mo) AS sales_2br_12mo,
    sum(sales_3br_plus_12mo) AS sales_3br_plus_12mo,
    round(avg(avg_list_price)) AS avg_list_price,
    round(avg(median_list_price)) AS median_list_price,
    round(avg(avg_list_price_ft2)) AS avg_list_price_ft2,
    round(avg(avg_sold_price)) AS avg_sold_price,
    round(avg(median_sold_price)) AS median_sold_price,
    round(avg(median_sold_price_0br)) AS median_sold_price_0br,
    round(avg(median_sold_price_1br)) AS median_sold_price_1br,
    round(avg(median_sold_price_2br)) AS median_sold_price_2br,
    round(avg(median_sold_price_3br_plus)) AS median_sold_price_3br_plus,
    round(avg(avg_sold_price_ft2)) AS avg_sold_price_ft2,
    round(avg(avg_sold_price_ft2_0br)) AS avg_sold_price_ft2_0br,
    round(avg(avg_sold_price_ft2_1br)) AS avg_sold_price_ft2_1br,
    round(avg(avg_sold_price_ft2_2br)) AS avg_sold_price_ft2_2br,
    round(avg(avg_sold_price_ft2_3br_plus)) AS avg_sold_price_ft2_3br_plus,
    round(avg(current_avg_dom)) AS current_avg_dom,
    round(avg(sold_avg_dom_12mo)) AS sold_avg_dom_12mo,
        CASE
            WHEN (sum(sales_12mo) = (0)::numeric) THEN NULL::numeric
            ELSE round((sum(active_count) / (sum(sales_12mo) / (12)::numeric)), 1)
        END AS months_inventory,
        CASE
            WHEN (sum(sales_0br_12mo) = (0)::numeric) THEN NULL::numeric
            ELSE round((sum(active_0br) / (sum(sales_0br_12mo) / (12)::numeric)), 1)
        END AS months_inventory_0br,
        CASE
            WHEN (sum(sales_1br_12mo) = (0)::numeric) THEN NULL::numeric
            ELSE round((sum(active_1br) / (sum(sales_1br_12mo) / (12)::numeric)), 1)
        END AS months_inventory_1br,
        CASE
            WHEN (sum(sales_2br_12mo) = (0)::numeric) THEN NULL::numeric
            ELSE round((sum(active_2br) / (sum(sales_2br_12mo) / (12)::numeric)), 1)
        END AS months_inventory_2br,
        CASE
            WHEN (sum(sales_3br_plus_12mo) = (0)::numeric) THEN NULL::numeric
            ELSE round((sum(active_3br_plus) / (sum(sales_3br_plus_12mo) / (12)::numeric)), 1)
        END AS months_inventory_3br_plus,
    count(*) AS community_count
   FROM community_snapshot
  GROUP BY zone_name, zone_slug, area_name, area_slug, snapshot_date, market_segment, property_type_segment]]></view_script>
			<column name="zone_name" type="text" />
			<column name="zone_slug" type="text" />
			<column name="area_name" type="text" />
			<column name="area_slug" type="text" />
			<column name="snapshot_date" type="date" />
			<column name="market_segment" type="text" />
			<column name="property_type_segment" type="text" />
			<column name="sales_period_start" type="date" />
			<column name="sales_period_end" type="date" />
			<column name="active_count" type="numeric" />
			<column name="pending_count" type="numeric" />
			<column name="active_0br" type="numeric" />
			<column name="active_1br" type="numeric" />
			<column name="active_2br" type="numeric" />
			<column name="active_3br_plus" type="numeric" />
			<column name="pending_0br" type="numeric" />
			<column name="pending_1br" type="numeric" />
			<column name="pending_2br" type="numeric" />
			<column name="pending_3br_plus" type="numeric" />
			<column name="sales_12mo" type="numeric" />
			<column name="sales_0br_12mo" type="numeric" />
			<column name="sales_1br_12mo" type="numeric" />
			<column name="sales_2br_12mo" type="numeric" />
			<column name="sales_3br_plus_12mo" type="numeric" />
			<column name="avg_list_price" type="numeric" />
			<column name="median_list_price" type="double precision" />
			<column name="avg_list_price_ft2" type="numeric" />
			<column name="avg_sold_price" type="numeric" />
			<column name="median_sold_price" type="double precision" />
			<column name="median_sold_price_0br" type="double precision" />
			<column name="median_sold_price_1br" type="double precision" />
			<column name="median_sold_price_2br" type="double precision" />
			<column name="median_sold_price_3br_plus" type="double precision" />
			<column name="avg_sold_price_ft2" type="numeric" />
			<column name="avg_sold_price_ft2_0br" type="numeric" />
			<column name="avg_sold_price_ft2_1br" type="numeric" />
			<column name="avg_sold_price_ft2_2br" type="numeric" />
			<column name="avg_sold_price_ft2_3br_plus" type="numeric" />
			<column name="current_avg_dom" type="numeric" />
			<column name="sold_avg_dom_12mo" type="numeric" />
			<column name="months_inventory" type="numeric" />
			<column name="months_inventory_0br" type="numeric" />
			<column name="months_inventory_1br" type="numeric" />
			<column name="months_inventory_2br" type="numeric" />
			<column name="months_inventory_3br_plus" type="numeric" />
			<column name="community_count" type="bigint" />
		</view>
		<view name="community_listing_drilldown" >
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH latest_snapshot AS (
         SELECT max(invntry_snap.invntry_snap_date_ky) AS invntry_snap_date_ky
           FROM dw.invntry_snap), base_inventory AS (
         SELECT p.zone_ds AS zone_name,
            p.area_ds AS area_name,
            p.cmnty_ds AS community_name,
            l.lstng_nb,
                CASE
                    WHEN (i.pre_cnstrctn_fl = true) THEN 'pre_construction'::text
                    ELSE 'resale'::text
                END AS market_segment,
                CASE
                    WHEN (lower(COALESCE(l.prprty_type_cd, ''::text)) ~~ '%house%'::text) THEN 'houses'::text
                    ELSE 'condos'::text
                END AS property_type_segment,
                CASE
                    WHEN (COALESCE(l.bdrm_nb, (0)::numeric) = (0)::numeric) THEN '0br'::text
                    WHEN (l.bdrm_nb = (1)::numeric) THEN '1br'::text
                    WHEN (l.bdrm_nb = (2)::numeric) THEN '2br'::text
                    ELSE '3br_plus'::text
                END AS bedroom_segment,
                CASE
                    WHEN (i.stts_cd = 'A'::text) THEN 'active'::text
                    WHEN (i.stts_cd = 'P'::text) THEN 'pending'::text
                    ELSE NULL::text
                END AS metric_group
           FROM (((dw.invntry_snap i
             JOIN latest_snapshot ls ON ((i.invntry_snap_date_ky = ls.invntry_snap_date_ky)))
             JOIN dw.lstng l ON ((i.lstng_ky = l.lstng_ky)))
             JOIN dw.prprty p ON ((l.prprty_ky = p.prprty_ky)))
          WHERE ((i.stts_cd = ANY (ARRAY['A'::text, 'P'::text])) AND (p.zone_ds IS NOT NULL) AND (p.area_ds IS NOT NULL) AND (p.cmnty_ds IS NOT NULL) AND (l.lstng_nb IS NOT NULL))), base_sales AS (
         SELECT p.zone_ds AS zone_name,
            p.area_ds AS area_name,
            p.cmnty_ds AS community_name,
            l.lstng_nb,
                CASE
                    WHEN (s.pre_cnstrctn_fl = true) THEN 'pre_construction'::text
                    ELSE 'resale'::text
                END AS market_segment,
                CASE
                    WHEN (lower(COALESCE(l.prprty_type_cd, ''::text)) ~~ '%house%'::text) THEN 'houses'::text
                    ELSE 'condos'::text
                END AS property_type_segment,
                CASE
                    WHEN (COALESCE(l.bdrm_nb, (0)::numeric) = (0)::numeric) THEN '0br'::text
                    WHEN (l.bdrm_nb = (1)::numeric) THEN '1br'::text
                    WHEN (l.bdrm_nb = (2)::numeric) THEN '2br'::text
                    ELSE '3br_plus'::text
                END AS bedroom_segment,
            'sold_12mo'::text AS metric_group
           FROM ((dw.clsd_sale s
             JOIN dw.lstng l ON ((s.lstng_ky = l.lstng_ky)))
             JOIN dw.prprty p ON ((l.prprty_ky = p.prprty_ky)))
          WHERE ((to_date((s.sold_date_ky)::text, 'YYYYMMDD'::text) >= (CURRENT_DATE - '1 year'::interval)) AND (p.zone_ds IS NOT NULL) AND (p.area_ds IS NOT NULL) AND (p.cmnty_ds IS NOT NULL) AND (l.lstng_nb IS NOT NULL))), base_rows AS (
         SELECT base_inventory.zone_name,
            base_inventory.area_name,
            base_inventory.community_name,
            base_inventory.lstng_nb,
            base_inventory.market_segment,
            base_inventory.property_type_segment,
            base_inventory.bedroom_segment,
            base_inventory.metric_group
           FROM base_inventory
        UNION ALL
         SELECT base_sales.zone_name,
            base_sales.area_name,
            base_sales.community_name,
            base_sales.lstng_nb,
            base_sales.market_segment,
            base_sales.property_type_segment,
            base_sales.bedroom_segment,
            base_sales.metric_group
           FROM base_sales), expanded_rows AS (
         SELECT b.zone_name,
            b.area_name,
            b.community_name,
            m.market_segment,
            pt.property_type_segment,
            b.metric_group,
            br.bedroom_segment,
            b.lstng_nb
           FROM (((base_rows b
             CROSS JOIN LATERAL ( VALUES (b.market_segment), ('all'::text)) m(market_segment))
             CROSS JOIN LATERAL ( VALUES (b.property_type_segment), ('all'::text)) pt(property_type_segment))
             CROSS JOIN LATERAL ( VALUES (b.bedroom_segment), ('all'::text)) br(bedroom_segment)))
 SELECT zone_name,
    lower(regexp_replace(regexp_replace(translate(zone_name, 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS zone_slug,
    area_name,
    lower(regexp_replace(regexp_replace(translate(area_name, 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS area_slug,
    community_name,
    lower(regexp_replace(regexp_replace(translate(community_name, 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS community_slug,
    market_segment,
    property_type_segment,
    metric_group,
    bedroom_segment,
    count(*) AS listing_count,
    string_agg((lstng_nb)::text, ','::text ORDER BY lstng_nb DESC) AS listing_ids
   FROM expanded_rows
  GROUP BY zone_name, area_name, community_name, market_segment, property_type_segment, metric_group, bedroom_segment]]></view_script>
			<column name="zone_name" type="text" />
			<column name="zone_slug" type="text" />
			<column name="area_name" type="text" />
			<column name="area_slug" type="text" />
			<column name="community_name" type="text" />
			<column name="community_slug" type="text" />
			<column name="market_segment" type="text" />
			<column name="property_type_segment" type="text" />
			<column name="metric_group" type="text" />
			<column name="bedroom_segment" type="text" />
			<column name="listing_count" type="bigint" />
			<column name="listing_ids" type="text" />
		</view>
		<view name="community_snapshot" >
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH latest_snap_date AS (
         SELECT max(invntry_snap.invntry_snap_date_ky) AS invntry_snap_date_ky
           FROM dw.invntry_snap), snapshot_date AS (
         SELECT c.clndr_ky AS invntry_snap_date_ky,
            c.full_dt AS snapshot_date
           FROM (dw.clndr c
             JOIN latest_snap_date d ON ((c.clndr_ky = d.invntry_snap_date_ky)))), market_segments AS (
         SELECT x.market_segment,
            x.pre_cnstrctn_fl
           FROM ( VALUES ('all'::text,NULL::boolean), ('pre_construction'::text,true), ('resale'::text,false)) x(market_segment, pre_cnstrctn_fl)), property_type_segments AS (
         SELECT x.property_type_segment,
            x.prprty_type
           FROM ( VALUES ('all'::text,NULL::text), ('condos'::text,'Condos'::text), ('houses'::text,'Houses'::text)) x(property_type_segment, prprty_type)), current_inventory AS (
         SELECT p.zone_ds,
            p.area_ds,
            p.cmnty_ds,
            sd.snapshot_date,
            ms.market_segment,
            pts.property_type_segment,
            count(*) FILTER (WHERE (lower(i.stts_cd) = 'a'::text)) AS active_count,
            count(*) FILTER (WHERE (lower(i.stts_cd) = 'p'::text)) AS pending_count,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'a'::text) AND (l.bdrm_nb = (0)::numeric))) AS active_0br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'a'::text) AND (l.bdrm_nb = (1)::numeric))) AS active_1br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'a'::text) AND (l.bdrm_nb = (2)::numeric))) AS active_2br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'a'::text) AND (l.bdrm_nb >= (3)::numeric))) AS active_3br_plus,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'p'::text) AND (l.bdrm_nb = (0)::numeric))) AS pending_0br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'p'::text) AND (l.bdrm_nb = (1)::numeric))) AS pending_1br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'p'::text) AND (l.bdrm_nb = (2)::numeric))) AS pending_2br,
            count(*) FILTER (WHERE ((lower(i.stts_cd) = 'p'::text) AND (l.bdrm_nb >= (3)::numeric))) AS pending_3br_plus,
            round(avg(i.snap_list_prc_am) FILTER (WHERE (lower(i.stts_cd) = 'a'::text))) AS avg_list_price,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((i.snap_list_prc_am)::double precision)) FILTER (WHERE (lower(i.stts_cd) = 'a'::text)) AS median_list_price,
            round(avg(i.prc_ft2_qt) FILTER (WHERE (lower(i.stts_cd) = 'a'::text))) AS avg_list_price_ft2,
            round(avg((i.prc_ft2_qt * 10.7639)) FILTER (WHERE (lower(i.stts_cd) = 'a'::text))) AS avg_list_price_m2,
            round(avg(i.dom_qt) FILTER (WHERE ((lower(i.stts_cd) = 'a'::text) AND ((i.dom_qt >= 0) AND (i.dom_qt <= 5000))))) AS current_avg_dom
           FROM (((((dw.invntry_snap i
             JOIN snapshot_date sd ON ((i.invntry_snap_date_ky = sd.invntry_snap_date_ky)))
             JOIN dw.prprty p ON ((i.prprty_ky = p.prprty_ky)))
             JOIN dw.lstng l ON ((i.lstng_ky = l.lstng_ky)))
             JOIN market_segments ms ON (((ms.pre_cnstrctn_fl IS NULL) OR (COALESCE(i.pre_cnstrctn_fl, false) = ms.pre_cnstrctn_fl))))
             JOIN property_type_segments pts ON (((pts.prprty_type IS NULL) OR (p.prprty_type = pts.prprty_type))))
          WHERE (p.cmnty_ds IS NOT NULL)
          GROUP BY p.zone_ds, p.area_ds, p.cmnty_ds, sd.snapshot_date, ms.market_segment, pts.property_type_segment), sales_12mo AS (
         SELECT p.zone_ds,
            p.area_ds,
            p.cmnty_ds,
            sd.snapshot_date,
            ms.market_segment,
            pts.property_type_segment,
            ((sd.snapshot_date - '1 year'::interval))::date AS sales_period_start,
            sd.snapshot_date AS sales_period_end,
            count(*) AS sales_12mo,
            count(*) FILTER (WHERE (l.bdrm_nb = (0)::numeric)) AS sales_0br_12mo,
            count(*) FILTER (WHERE (l.bdrm_nb = (1)::numeric)) AS sales_1br_12mo,
            count(*) FILTER (WHERE (l.bdrm_nb = (2)::numeric)) AS sales_2br_12mo,
            count(*) FILTER (WHERE (l.bdrm_nb >= (3)::numeric)) AS sales_3br_plus_12mo,
            round(avg(cs.sold_prc_am)) AS avg_sold_price,
            round(avg(cs.sold_prc_am) FILTER (WHERE (l.bdrm_nb = (0)::numeric))) AS avg_sold_price_0br,
            round(avg(cs.sold_prc_am) FILTER (WHERE (l.bdrm_nb = (1)::numeric))) AS avg_sold_price_1br,
            round(avg(cs.sold_prc_am) FILTER (WHERE (l.bdrm_nb = (2)::numeric))) AS avg_sold_price_2br,
            round(avg(cs.sold_prc_am) FILTER (WHERE (l.bdrm_nb >= (3)::numeric))) AS avg_sold_price_3br_plus,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_am)::double precision)) AS median_sold_price,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (0)::numeric)) AS median_sold_price_0br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (1)::numeric)) AS median_sold_price_1br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (2)::numeric)) AS median_sold_price_2br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_am)::double precision)) FILTER (WHERE (l.bdrm_nb >= (3)::numeric)) AS median_sold_price_3br_plus,
            round(avg(cs.sold_prc_ft2_am)) AS avg_sold_price_ft2,
            round(avg(cs.sold_prc_ft2_am) FILTER (WHERE (l.bdrm_nb = (0)::numeric))) AS avg_sold_price_ft2_0br,
            round(avg(cs.sold_prc_ft2_am) FILTER (WHERE (l.bdrm_nb = (1)::numeric))) AS avg_sold_price_ft2_1br,
            round(avg(cs.sold_prc_ft2_am) FILTER (WHERE (l.bdrm_nb = (2)::numeric))) AS avg_sold_price_ft2_2br,
            round(avg(cs.sold_prc_ft2_am) FILTER (WHERE (l.bdrm_nb >= (3)::numeric))) AS avg_sold_price_ft2_3br_plus,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_ft2_am)::double precision)) AS median_sold_price_ft2,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_ft2_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (0)::numeric)) AS median_sold_price_ft2_0br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_ft2_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (1)::numeric)) AS median_sold_price_ft2_1br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_ft2_am)::double precision)) FILTER (WHERE (l.bdrm_nb = (2)::numeric)) AS median_sold_price_ft2_2br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY ((cs.sold_prc_ft2_am)::double precision)) FILTER (WHERE (l.bdrm_nb >= (3)::numeric)) AS median_sold_price_ft2_3br_plus,
            round(avg((cs.sold_prc_ft2_am * 10.7639))) AS avg_sold_price_m2,
            round(avg((cs.sold_prc_ft2_am * 10.7639)) FILTER (WHERE (l.bdrm_nb = (0)::numeric))) AS avg_sold_price_m2_0br,
            round(avg((cs.sold_prc_ft2_am * 10.7639)) FILTER (WHERE (l.bdrm_nb = (1)::numeric))) AS avg_sold_price_m2_1br,
            round(avg((cs.sold_prc_ft2_am * 10.7639)) FILTER (WHERE (l.bdrm_nb = (2)::numeric))) AS avg_sold_price_m2_2br,
            round(avg((cs.sold_prc_ft2_am * 10.7639)) FILTER (WHERE (l.bdrm_nb >= (3)::numeric))) AS avg_sold_price_m2_3br_plus,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY (((cs.sold_prc_ft2_am * 10.7639))::double precision)) AS median_sold_price_m2,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY (((cs.sold_prc_ft2_am * 10.7639))::double precision)) FILTER (WHERE (l.bdrm_nb = (0)::numeric)) AS median_sold_price_m2_0br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY (((cs.sold_prc_ft2_am * 10.7639))::double precision)) FILTER (WHERE (l.bdrm_nb = (1)::numeric)) AS median_sold_price_m2_1br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY (((cs.sold_prc_ft2_am * 10.7639))::double precision)) FILTER (WHERE (l.bdrm_nb = (2)::numeric)) AS median_sold_price_m2_2br,
            percentile_cont((0.5)::double precision) WITHIN GROUP (ORDER BY (((cs.sold_prc_ft2_am * 10.7639))::double precision)) FILTER (WHERE (l.bdrm_nb >= (3)::numeric)) AS median_sold_price_m2_3br_plus,
            round(avg(cs.dom_nb) FILTER (WHERE ((cs.dom_nb >= 0) AND (cs.dom_nb <= 5000)))) AS sold_avg_dom_12mo
           FROM ((((((snapshot_date sd
             JOIN dw.clsd_sale cs ON (true))
             JOIN dw.prprty p ON ((cs.prprty_ky = p.prprty_ky)))
             JOIN dw.lstng l ON ((cs.lstng_ky = l.lstng_ky)))
             JOIN dw.clndr c ON ((cs.sold_date_ky = c.clndr_ky)))
             JOIN market_segments ms ON (((ms.pre_cnstrctn_fl IS NULL) OR (COALESCE(cs.pre_cnstrctn_fl, false) = ms.pre_cnstrctn_fl))))
             JOIN property_type_segments pts ON (((pts.prprty_type IS NULL) OR (p.prprty_type = pts.prprty_type))))
          WHERE ((c.full_dt >= (sd.snapshot_date - '1 year'::interval)) AND (c.full_dt <= sd.snapshot_date) AND (p.cmnty_ds IS NOT NULL))
          GROUP BY p.zone_ds, p.area_ds, p.cmnty_ds, sd.snapshot_date, ms.market_segment, pts.property_type_segment)
 SELECT COALESCE(ci.zone_ds, s.zone_ds) AS zone_name,
    COALESCE(ci.area_ds, s.area_ds) AS area_name,
    COALESCE(ci.cmnty_ds, s.cmnty_ds) AS community_name,
    COALESCE(ci.snapshot_date, s.snapshot_date) AS snapshot_date,
    COALESCE(ci.market_segment, s.market_segment) AS market_segment,
    COALESCE(ci.property_type_segment, s.property_type_segment) AS property_type_segment,
    COALESCE(s.sales_period_start, ((COALESCE(ci.snapshot_date, s.snapshot_date) - '1 year'::interval))::date) AS sales_period_start,
    COALESCE(s.sales_period_end, COALESCE(ci.snapshot_date, s.snapshot_date)) AS sales_period_end,
    COALESCE(ci.active_count, (0)::bigint) AS active_count,
    COALESCE(ci.pending_count, (0)::bigint) AS pending_count,
    COALESCE(ci.active_0br, (0)::bigint) AS active_0br,
    COALESCE(ci.active_1br, (0)::bigint) AS active_1br,
    COALESCE(ci.active_2br, (0)::bigint) AS active_2br,
    COALESCE(ci.active_3br_plus, (0)::bigint) AS active_3br_plus,
    COALESCE(ci.pending_0br, (0)::bigint) AS pending_0br,
    COALESCE(ci.pending_1br, (0)::bigint) AS pending_1br,
    COALESCE(ci.pending_2br, (0)::bigint) AS pending_2br,
    COALESCE(ci.pending_3br_plus, (0)::bigint) AS pending_3br_plus,
    ci.avg_list_price,
    ci.median_list_price,
    ci.avg_list_price_ft2,
    ci.current_avg_dom,
    COALESCE(s.sales_12mo, (0)::bigint) AS sales_12mo,
    COALESCE(s.sales_0br_12mo, (0)::bigint) AS sales_0br_12mo,
    COALESCE(s.sales_1br_12mo, (0)::bigint) AS sales_1br_12mo,
    COALESCE(s.sales_2br_12mo, (0)::bigint) AS sales_2br_12mo,
    COALESCE(s.sales_3br_plus_12mo, (0)::bigint) AS sales_3br_plus_12mo,
    s.avg_sold_price,
    s.median_sold_price,
    s.median_sold_price_0br,
    s.median_sold_price_1br,
    s.median_sold_price_2br,
    s.median_sold_price_3br_plus,
    s.avg_sold_price_ft2,
    s.avg_sold_price_ft2_0br,
    s.avg_sold_price_ft2_1br,
    s.avg_sold_price_ft2_2br,
    s.avg_sold_price_ft2_3br_plus,
    s.sold_avg_dom_12mo,
        CASE
            WHEN (COALESCE(s.sales_12mo, (0)::bigint) = 0) THEN NULL::numeric
            ELSE round(((COALESCE(ci.active_count, (0)::bigint))::numeric / ((s.sales_12mo)::numeric / (12)::numeric)), 1)
        END AS months_inventory,
        CASE
            WHEN (COALESCE(s.sales_0br_12mo, (0)::bigint) = 0) THEN NULL::numeric
            ELSE round(((COALESCE(ci.active_0br, (0)::bigint))::numeric / ((s.sales_0br_12mo)::numeric / (12)::numeric)), 1)
        END AS months_inventory_0br,
        CASE
            WHEN (COALESCE(s.sales_1br_12mo, (0)::bigint) = 0) THEN NULL::numeric
            ELSE round(((COALESCE(ci.active_1br, (0)::bigint))::numeric / ((s.sales_1br_12mo)::numeric / (12)::numeric)), 1)
        END AS months_inventory_1br,
        CASE
            WHEN (COALESCE(s.sales_2br_12mo, (0)::bigint) = 0) THEN NULL::numeric
            ELSE round(((COALESCE(ci.active_2br, (0)::bigint))::numeric / ((s.sales_2br_12mo)::numeric / (12)::numeric)), 1)
        END AS months_inventory_2br,
        CASE
            WHEN (COALESCE(s.sales_3br_plus_12mo, (0)::bigint) = 0) THEN NULL::numeric
            ELSE round(((COALESCE(ci.active_3br_plus, (0)::bigint))::numeric / ((s.sales_3br_plus_12mo)::numeric / (12)::numeric)), 1)
        END AS months_inventory_3br_plus,
    lower(regexp_replace(regexp_replace(translate(COALESCE(ci.zone_ds, s.zone_ds), 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS zone_slug,
    lower(regexp_replace(regexp_replace(translate(COALESCE(ci.area_ds, s.area_ds), 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS area_slug,
    lower(regexp_replace(regexp_replace(translate(COALESCE(ci.cmnty_ds, s.cmnty_ds), 'áéíóúÁÉÍÓÚñÑ'::text, 'aeiouAEIOUnN'::text), '[^a-zA-Z0-9]+'::text, '-'::text, 'g'::text), '(^-|-$)'::text, ''::text, 'g'::text)) AS community_slug,
    ci.avg_list_price_m2,
    s.avg_sold_price_0br,
    s.avg_sold_price_1br,
    s.avg_sold_price_2br,
    s.avg_sold_price_3br_plus,
    s.median_sold_price_ft2,
    s.median_sold_price_ft2_0br,
    s.median_sold_price_ft2_1br,
    s.median_sold_price_ft2_2br,
    s.median_sold_price_ft2_3br_plus,
    s.avg_sold_price_m2,
    s.avg_sold_price_m2_0br,
    s.avg_sold_price_m2_1br,
    s.avg_sold_price_m2_2br,
    s.avg_sold_price_m2_3br_plus,
    s.median_sold_price_m2,
    s.median_sold_price_m2_0br,
    s.median_sold_price_m2_1br,
    s.median_sold_price_m2_2br,
    s.median_sold_price_m2_3br_plus
   FROM (current_inventory ci
     FULL JOIN sales_12mo s ON (((ci.zone_ds = s.zone_ds) AND (ci.area_ds = s.area_ds) AND (ci.cmnty_ds = s.cmnty_ds) AND (ci.market_segment = s.market_segment) AND (ci.property_type_segment = s.property_type_segment))))
  WHERE ((COALESCE(ci.active_count, (0)::bigint) > 0) OR (COALESCE(ci.pending_count, (0)::bigint) > 0) OR (COALESCE(s.sales_12mo, (0)::bigint) > 0))]]></view_script>
