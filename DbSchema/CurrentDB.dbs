			<column name="ft2_lot_nb" type="numeric" />
			<column name="m2_cnstrctn_nb" type="numeric" />
			<column name="ft2_cnstrctn_nb" type="numeric" />
			<column name="year_blt_dt" type="integer" />
			<column name="flr_nb" type="text" />
