		<function name="geography_cmp" id="bfbac339-6f39-4e30-8e73-a98f500d0fa1" isSystem="false" params_known="n" >
			<string><![CDATA[CREATE OR REPLACE FUNCTION public.geography_cmp(geography, geography)
