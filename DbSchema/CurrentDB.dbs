<?xml version="1.0" encoding="UTF-8" ?>
<project name="PostgreSQL" database="PostgreSQL" id="fde91862-e5cd-491b-b357-c82f27eec6dc" >
	<schema name="auth" catalogname="postgres" >
		<udt name="aal_level" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('aal1','aal2','aal3')]]></udt_script>
		</udt>
		<udt name="code_challenge_method" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('s256','plain')]]></udt_script>
		</udt>
		<udt name="factor_status" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('unverified','verified')]]></udt_script>
		</udt>
		<udt name="factor_type" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('totp','webauthn','phone')]]></udt_script>
		</udt>
		<udt name="oauth_authorization_status" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('pending','approved','denied','expired')]]></udt_script>
		</udt>
		<udt name="oauth_client_type" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('public','confidential')]]></udt_script>
		</udt>
		<udt name="oauth_registration_type" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('dynamic','manual')]]></udt_script>
		</udt>
		<udt name="oauth_response_type" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('code')]]></udt_script>
		</udt>
		<udt name="one_time_token_type" udt_value_type="VARCHAR" udt_precision="NONE" sync_priority="900" >
			<udt_script><![CDATA[CREATE TYPE ${name} AS ENUM ('confirmation_token','reauthentication_token','recovery_token','email_change_token_new','email_change_token_current','phone_change_token')]]></udt_script>
		</udt>
		<table name="audit_log_entries" row_count="0" spec="" >
			<comment><![CDATA[Auth: Audit trail for user actions.]]></comment>
			<column name="instance_id" type="uuid" />
			<column name="id" type="uuid" mandatory="y" />
			<column name="payload" type="json" />
			<column name="created_at" type="timestamptz" />
			<column name="ip_address" type="varchar" length="64" mandatory="y" >
				<defo><![CDATA[''::character varying]]></defo>
			</column>
			<index name="audit_log_entries_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="audit_logs_instance_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="instance_id" />
			</index>
		</table>
		<table name="custom_oauth_providers" row_count="0" spec="" >
			<column name="id" type="uuid" mandatory="y" >
				<defo><![CDATA[gen_random_uuid()]]></defo>
			</column>
			<column name="provider_type" type="text" mandatory="y" />
			<column name="identifier" type="text" mandatory="y" />
			<column name="name" type="text" mandatory="y" />
			<column name="client_id" type="text" mandatory="y" />
			<column name="client_secret" type="text" mandatory="y" />
			<column name="acceptable_client_ids" type="text[]" mandatory="y" >
				<defo><![CDATA['{}'::text[]]]></defo>
			</column>
			<column name="scopes" type="text[]" mandatory="y" >
				<defo><![CDATA['{}'::text[]]]></defo>
			</column>
			<column name="pkce_enabled" type="boolean" mandatory="y" >
				<defo><![CDATA[true]]></defo>
			</column>
			<column name="attribute_mapping" type="jsonb" mandatory="y" >
				<defo><![CDATA['{}'::jsonb]]></defo>
			</column>
			<column name="authorization_params" type="jsonb" mandatory="y" >
				<defo><![CDATA['{}'::jsonb]]></defo>
			</column>
			<column name="enabled" type="boolean" mandatory="y" >
				<defo><![CDATA[true]]></defo>
			</column>
			<column name="email_optional" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="issuer" type="text" />
			<column name="discovery_url" type="text" />
			<column name="skip_nonce_check" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="cached_discovery" type="jsonb" />
			<column name="discovery_cached_at" type="timestamptz" />
			<column name="authorization_url" type="text" />
			<column name="token_url" type="text" />
			<column name="userinfo_url" type="text" />
			<column name="jwks_uri" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="updated_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="custom_claims_allowlist" type="text[]" mandatory="y" >
				<defo><![CDATA['{}'::text[]]]></defo>
			</column>
			<index name="custom_oauth_providers_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="custom_oauth_providers_identifier_idx" unique="NORMAL" spec="USING  btree" >
				<column name="identifier" />
			</index>
			<index name="custom_oauth_providers_provider_type_idx" unique="NORMAL" spec="USING  btree" >
				<column name="provider_type" />
			</index>
			<index name="custom_oauth_providers_enabled_idx" unique="NORMAL" spec="USING  btree" >
				<column name="enabled" />
			</index>
			<index name="custom_oauth_providers_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="created_at" />
			</index>
			<constraint name="custom_oauth_providers_client_id_length" type="CHECK" options="" >
				<string><![CDATA[char_length(client_id) >= 1) AND (char_length(client_id) <= 512]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_discovery_url_length" type="CHECK" options="" >
				<string><![CDATA[discovery_url IS NULL) OR (char_length(discovery_url) <= 2048]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_identifier_format" type="CHECK" options="" >
				<string><![CDATA[identifier ~ '^[a-z0-9][a-z0-9:-]{0,48}[a-z0-9]$'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_issuer_length" type="CHECK" options="" >
				<string><![CDATA[issuer IS NULL) OR ((char_length(issuer) >= 1) AND (char_length(issuer) <= 2048)]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_jwks_uri_https" type="CHECK" options="" >
				<string><![CDATA[jwks_uri IS NULL) OR (jwks_uri ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_jwks_uri_length" type="CHECK" options="" >
				<string><![CDATA[jwks_uri IS NULL) OR (char_length(jwks_uri) <= 2048]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_name_length" type="CHECK" options="" >
				<string><![CDATA[char_length(name) >= 1) AND (char_length(name) <= 100]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_oauth2_requires_endpoints" type="CHECK" options="" >
				<string><![CDATA[provider_type <> 'oauth2'::text) OR ((authorization_url IS NOT NULL) AND (token_url IS NOT NULL) AND (userinfo_url IS NOT NULL)]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_oidc_discovery_url_https" type="CHECK" options="" >
				<string><![CDATA[provider_type <> 'oidc'::text) OR (discovery_url IS NULL) OR (discovery_url ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_oidc_issuer_https" type="CHECK" options="" >
				<string><![CDATA[provider_type <> 'oidc'::text) OR (issuer IS NULL) OR (issuer ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_oidc_requires_issuer" type="CHECK" options="" >
				<string><![CDATA[provider_type <> 'oidc'::text) OR (issuer IS NOT NULL]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_provider_type_check" type="CHECK" options="" >
				<string><![CDATA[provider_type = ANY (ARRAY['oauth2'::text, 'oidc'::text])]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_token_url_https" type="CHECK" options="" >
				<string><![CDATA[token_url IS NULL) OR (token_url ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_token_url_length" type="CHECK" options="" >
				<string><![CDATA[token_url IS NULL) OR (char_length(token_url) <= 2048]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_userinfo_url_https" type="CHECK" options="" >
				<string><![CDATA[userinfo_url IS NULL) OR (userinfo_url ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_authorization_url_https" type="CHECK" options="" >
				<string><![CDATA[authorization_url IS NULL) OR (authorization_url ~~ 'https://%'::text]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_userinfo_url_length" type="CHECK" options="" >
				<string><![CDATA[userinfo_url IS NULL) OR (char_length(userinfo_url) <= 2048]]></string>
			</constraint>
			<constraint name="custom_oauth_providers_authorization_url_length" type="CHECK" options="" >
				<string><![CDATA[authorization_url IS NULL) OR (char_length(authorization_url) <= 2048]]></string>
			</constraint>
		</table>
		<table name="flow_state" row_count="0" spec="" >
			<comment><![CDATA[Stores metadata for all OAuth/SSO login flows]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" />
			<column name="auth_code" type="text" />
			<column name="code_challenge_method" type="code_challenge_method" />
			<column name="code_challenge" type="text" />
			<column name="provider_type" type="text" mandatory="y" />
			<column name="provider_access_token" type="text" />
			<column name="provider_refresh_token" type="text" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="authentication_method" type="text" mandatory="y" />
			<column name="auth_code_issued_at" type="timestamptz" />
			<column name="invite_token" type="text" />
			<column name="referrer" type="text" />
			<column name="oauth_client_state_id" type="uuid" />
			<column name="linking_target_id" type="uuid" />
			<column name="email_optional" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<index name="flow_state_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_auth_code" unique="NORMAL" spec="USING  btree" >
				<column name="auth_code" />
			</index>
			<index name="idx_user_id_auth_method" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
				<column name="authentication_method" />
			</index>
			<index name="flow_state_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="created_at" options=" DESC" />
			</index>
		</table>
		<table name="identities" row_count="0" spec="" >
			<comment><![CDATA[Auth: Stores identities associated to a user.]]></comment>
			<column name="provider_id" type="text" mandatory="y" />
			<column name="user_id" type="uuid" mandatory="y" />
			<column name="identity_data" type="jsonb" mandatory="y" >
				<column name="sub" type="_string" virtual="y" />
				<column name="email" type="_string" virtual="y" />
				<column name="email_verified" type="_boolean" virtual="y" />
				<column name="phone_verified" type="_boolean" virtual="y" />
			</column>
			<column name="provider" type="text" mandatory="y" />
			<column name="last_sign_in_at" type="timestamptz" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="email" type="text" >
				<column_options><![CDATA[GENERATED ALWAYS AS (lower((identity_data ->> 'email'::text))) STORED]]></column_options>
				<comment><![CDATA[Auth: Email is a generated column that references the optional email property in the identity_data]]></comment>
			</column>
			<column name="id" type="uuid" mandatory="y" >
				<defo><![CDATA[gen_random_uuid()]]></defo>
			</column>
			<index name="identities_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="identities_provider_id_provider_unique" unique="UNIQUE_KEY" >
				<column name="provider_id" />
				<column name="provider" />
			</index>
			<index name="identities_user_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
			</index>
			<index name="identities_email_idx" unique="NORMAL" spec="USING  btree" >
				<comment><![CDATA[Auth: Ensures indexed queries on the email column]]></comment>
				<column name="email" options=" text_pattern_ops" />
			</index>
			<fk name="identities_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="instances" row_count="0" spec="" >
			<comment><![CDATA[Auth: Manages users across multiple sites.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="uuid" type="uuid" />
			<column name="raw_base_config" type="text" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<index name="instances_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="mfa_amr_claims" row_count="0" spec="" >
			<comment><![CDATA[auth: stores authenticator method reference claims for multi factor authentication]]></comment>
			<column name="session_id" type="uuid" mandatory="y" />
			<column name="created_at" type="timestamptz" mandatory="y" />
			<column name="updated_at" type="timestamptz" mandatory="y" />
			<column name="authentication_method" type="text" mandatory="y" />
			<column name="id" type="uuid" mandatory="y" />
			<index name="amr_id_pk" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="mfa_amr_claims_session_id_authentication_method_pkey" unique="UNIQUE_KEY" >
				<column name="session_id" />
				<column name="authentication_method" />
			</index>
			<fk name="mfa_amr_claims_session_id_fkey" to_schema="postgres.auth" to_table="sessions" delete_action="cascade" options="" >
				<fk_column name="session_id" pk="id" />
			</fk>
		</table>
		<table name="mfa_challenges" row_count="0" spec="" >
			<comment><![CDATA[auth: stores metadata about challenge requests made]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="factor_id" type="uuid" mandatory="y" />
			<column name="created_at" type="timestamptz" mandatory="y" />
			<column name="verified_at" type="timestamptz" />
			<column name="ip_address" type="inet" mandatory="y" />
			<column name="otp_code" type="text" />
			<column name="web_authn_session_data" type="jsonb" />
			<index name="mfa_challenges_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="mfa_challenge_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="created_at" options=" DESC" />
			</index>
			<fk name="mfa_challenges_auth_factor_id_fkey" to_schema="postgres.auth" to_table="mfa_factors" delete_action="cascade" options="" >
				<fk_column name="factor_id" pk="id" />
			</fk>
		</table>
		<table name="mfa_factors" row_count="0" spec="" >
			<comment><![CDATA[auth: stores metadata about factors]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" mandatory="y" />
			<column name="friendly_name" type="text" />
			<column name="factor_type" type="factor_type" mandatory="y" />
			<column name="status" type="factor_status" mandatory="y" />
			<column name="created_at" type="timestamptz" mandatory="y" />
			<column name="updated_at" type="timestamptz" mandatory="y" />
			<column name="secret" type="text" />
			<column name="phone" type="text" />
			<column name="last_challenged_at" type="timestamptz" />
			<column name="web_authn_credential" type="jsonb" />
			<column name="web_authn_aaguid" type="uuid" />
			<column name="last_webauthn_challenge_data" type="jsonb" >
				<comment><![CDATA[Stores the latest WebAuthn challenge data including attestation/assertion for customer verification]]></comment>
			</column>
			<index name="mfa_factors_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="mfa_factors_last_challenged_at_key" unique="UNIQUE_KEY" >
				<column name="last_challenged_at" />
			</index>
			<index name="mfa_factors_user_friendly_name_unique" unique="UNIQUE_INDEX" spec="USING  btree" options="WHERE (TRIM(BOTH FROM friendly_name) &lt;&gt; &#039;&#039;::text)" >
				<column name="friendly_name" />
				<column name="user_id" />
			</index>
			<index name="factor_id_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
				<column name="created_at" />
			</index>
			<index name="mfa_factors_user_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
			</index>
			<index name="unique_phone_factor_per_user" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="user_id" />
				<column name="phone" />
			</index>
			<fk name="mfa_factors_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="oauth_authorizations" row_count="0" spec="" >
			<column name="id" type="uuid" mandatory="y" />
			<column name="authorization_id" type="text" mandatory="y" />
			<column name="client_id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" />
			<column name="redirect_uri" type="text" mandatory="y" />
			<column name="scope" type="text" mandatory="y" />
			<column name="state" type="text" />
			<column name="resource" type="text" />
			<column name="code_challenge" type="text" />
			<column name="code_challenge_method" type="code_challenge_method" />
			<column name="response_type" type="oauth_response_type" mandatory="y" >
				<defo><![CDATA['code'::auth.oauth_response_type]]></defo>
			</column>
			<column name="status" type="oauth_authorization_status" mandatory="y" >
				<defo><![CDATA['pending'::auth.oauth_authorization_status]]></defo>
			</column>
			<column name="authorization_code" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="expires_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[(now() + '00:03:00'::interval)]]></defo>
			</column>
			<column name="approved_at" type="timestamptz" />
			<column name="nonce" type="text" />
			<index name="oauth_authorizations_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="oauth_authorizations_authorization_id_key" unique="UNIQUE_KEY" >
				<column name="authorization_id" />
			</index>
			<index name="oauth_authorizations_authorization_code_key" unique="UNIQUE_KEY" >
				<column name="authorization_code" />
			</index>
			<index name="oauth_auth_pending_exp_idx" unique="NORMAL" spec="USING  btree" options="WHERE (status = &#039;pending&#039;::auth.oauth_authorization_status)" >
				<column name="expires_at" />
			</index>
			<constraint name="oauth_authorizations_expires_at_future" type="CHECK" options="" >
				<string><![CDATA[expires_at > created_at]]></string>
			</constraint>
			<constraint name="oauth_authorizations_nonce_length" type="CHECK" options="" >
				<string><![CDATA[char_length(nonce) <= 255]]></string>
			</constraint>
			<constraint name="oauth_authorizations_redirect_uri_length" type="CHECK" options="" >
				<string><![CDATA[char_length(redirect_uri) <= 2048]]></string>
			</constraint>
			<constraint name="oauth_authorizations_resource_length" type="CHECK" options="" >
				<string><![CDATA[char_length(resource) <= 2048]]></string>
			</constraint>
			<constraint name="oauth_authorizations_scope_length" type="CHECK" options="" >
				<string><![CDATA[char_length(scope) <= 4096]]></string>
			</constraint>
			<constraint name="oauth_authorizations_state_length" type="CHECK" options="" >
				<string><![CDATA[char_length(state) <= 4096]]></string>
			</constraint>
			<constraint name="oauth_authorizations_authorization_code_length" type="CHECK" options="" >
				<string><![CDATA[char_length(authorization_code) <= 255]]></string>
			</constraint>
			<constraint name="oauth_authorizations_code_challenge_length" type="CHECK" options="" >
				<string><![CDATA[char_length(code_challenge) <= 128]]></string>
			</constraint>
			<fk name="oauth_authorizations_client_id_fkey" to_schema="postgres.auth" to_table="oauth_clients" delete_action="cascade" options="" >
				<fk_column name="client_id" pk="id" />
			</fk>
			<fk name="oauth_authorizations_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="oauth_client_states" row_count="0" spec="" >
			<comment><![CDATA[Stores OAuth states for third-party provider authentication flows where Supabase acts as the OAuth client.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="provider_type" type="text" mandatory="y" />
			<column name="code_verifier" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" />
			<index name="oauth_client_states_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_oauth_client_states_created_at" unique="NORMAL" spec="USING  btree" >
				<column name="created_at" />
			</index>
		</table>
		<table name="oauth_clients" row_count="0" spec="" >
			<column name="id" type="uuid" mandatory="y" />
			<column name="client_secret_hash" type="text" />
			<column name="registration_type" type="oauth_registration_type" mandatory="y" />
			<column name="redirect_uris" type="text" mandatory="y" />
			<column name="grant_types" type="text" mandatory="y" />
			<column name="client_name" type="text" />
			<column name="client_uri" type="text" />
			<column name="logo_uri" type="text" />
			<column name="created_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="updated_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="deleted_at" type="timestamptz" />
			<column name="client_type" type="oauth_client_type" mandatory="y" >
				<defo><![CDATA['confidential'::auth.oauth_client_type]]></defo>
			</column>
			<column name="token_endpoint_auth_method" type="text" mandatory="y" />
			<index name="oauth_clients_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="oauth_clients_deleted_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="deleted_at" />
			</index>
			<constraint name="oauth_clients_client_name_length" type="CHECK" options="" >
				<string><![CDATA[char_length(client_name) <= 1024]]></string>
			</constraint>
			<constraint name="oauth_clients_client_uri_length" type="CHECK" options="" >
				<string><![CDATA[char_length(client_uri) <= 2048]]></string>
			</constraint>
			<constraint name="oauth_clients_logo_uri_length" type="CHECK" options="" >
				<string><![CDATA[char_length(logo_uri) <= 2048]]></string>
			</constraint>
			<constraint name="oauth_clients_token_endpoint_auth_method_check" type="CHECK" options="" >
				<string><![CDATA[token_endpoint_auth_method = ANY (ARRAY['client_secret_basic'::text, 'client_secret_post'::text, 'none'::text])]]></string>
			</constraint>
		</table>
		<table name="oauth_consents" row_count="0" spec="" >
			<column name="id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" mandatory="y" />
			<column name="client_id" type="uuid" mandatory="y" />
			<column name="scopes" type="text" mandatory="y" />
			<column name="granted_at" type="timestamptz" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="revoked_at" type="timestamptz" />
			<index name="oauth_consents_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="oauth_consents_user_client_unique" unique="UNIQUE_KEY" >
				<column name="user_id" />
				<column name="client_id" />
			</index>
			<index name="oauth_consents_active_user_client_idx" unique="NORMAL" spec="USING  btree" options="WHERE (revoked_at IS NULL)" >
				<column name="user_id" />
				<column name="client_id" />
			</index>
			<index name="oauth_consents_user_order_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
				<column name="granted_at" options=" DESC" />
			</index>
			<index name="oauth_consents_active_client_idx" unique="NORMAL" spec="USING  btree" options="WHERE (revoked_at IS NULL)" >
				<column name="client_id" />
			</index>
			<constraint name="oauth_consents_revoked_after_granted" type="CHECK" options="" >
				<string><![CDATA[revoked_at IS NULL) OR (revoked_at >= granted_at]]></string>
			</constraint>
			<constraint name="oauth_consents_scopes_length" type="CHECK" options="" >
				<string><![CDATA[char_length(scopes) <= 2048]]></string>
			</constraint>
			<constraint name="oauth_consents_scopes_not_empty" type="CHECK" options="" >
				<string><![CDATA[char_length(TRIM(BOTH FROM scopes)) > 0]]></string>
			</constraint>
			<fk name="oauth_consents_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="oauth_consents_client_id_fkey" to_schema="postgres.auth" to_table="oauth_clients" delete_action="cascade" options="" >
				<fk_column name="client_id" pk="id" />
			</fk>
		</table>
		<table name="one_time_tokens" row_count="0" spec="" >
			<column name="id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" mandatory="y" />
			<column name="token_type" type="one_time_token_type" mandatory="y" />
			<column name="token_hash" type="text" mandatory="y" />
			<column name="relates_to" type="text" mandatory="y" />
			<column name="created_at" type="timestamp" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<column name="updated_at" type="timestamp" mandatory="y" >
				<defo><![CDATA[now()]]></defo>
			</column>
			<index name="one_time_tokens_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="one_time_tokens_token_hash_hash_idx" unique="NORMAL" spec="USING  hash" >
				<column name="token_hash" />
			</index>
			<index name="one_time_tokens_relates_to_hash_idx" unique="NORMAL" spec="USING  hash" >
				<column name="relates_to" />
			</index>
			<index name="one_time_tokens_user_id_token_type_key" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="user_id" />
				<column name="token_type" />
			</index>
			<constraint name="one_time_tokens_token_hash_check" type="CHECK" options="" >
				<string><![CDATA[char_length(token_hash) > 0]]></string>
			</constraint>
			<fk name="one_time_tokens_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
		</table>
		<table name="refresh_tokens" row_count="0" spec="" >
			<comment><![CDATA[Auth: Store of tokens used to refresh JWT tokens once they expire.]]></comment>
			<column name="instance_id" type="uuid" />
			<column name="id" type="bigint" mandatory="y" >
				<defo><![CDATA[nextval('auth.refresh_tokens_id_seq'::regclass)]]></defo>
			</column>
			<column name="token" type="varchar" length="255" />
			<column name="user_id" type="varchar" length="255" />
			<column name="revoked" type="boolean" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="parent" type="varchar" length="255" />
			<column name="session_id" type="uuid" />
			<index name="refresh_tokens_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="refresh_tokens_token_unique" unique="UNIQUE_KEY" >
				<column name="token" />
			</index>
			<index name="refresh_tokens_instance_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="instance_id" />
			</index>
			<index name="refresh_tokens_instance_id_user_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="instance_id" />
				<column name="user_id" />
			</index>
			<index name="refresh_tokens_parent_idx" unique="NORMAL" spec="USING  btree" >
				<column name="parent" />
			</index>
			<index name="refresh_tokens_session_id_revoked_idx" unique="NORMAL" spec="USING  btree" >
				<column name="session_id" />
				<column name="revoked" />
			</index>
			<index name="refresh_tokens_updated_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="updated_at" options=" DESC" />
			</index>
			<fk name="refresh_tokens_session_id_fkey" to_schema="postgres.auth" to_table="sessions" delete_action="cascade" options="" >
				<fk_column name="session_id" pk="id" />
			</fk>
		</table>
		<table name="saml_providers" row_count="0" spec="" >
			<comment><![CDATA[Auth: Manages SAML Identity Provider connections.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="sso_provider_id" type="uuid" mandatory="y" />
			<column name="entity_id" type="text" mandatory="y" />
			<column name="metadata_xml" type="text" mandatory="y" />
			<column name="metadata_url" type="text" />
			<column name="attribute_mapping" type="jsonb" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="name_id_format" type="text" />
			<index name="saml_providers_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="saml_providers_entity_id_key" unique="UNIQUE_KEY" >
				<column name="entity_id" />
			</index>
			<index name="saml_providers_sso_provider_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="sso_provider_id" />
			</index>
			<constraint name="entity_id not empty" type="CHECK" options="" >
				<string><![CDATA[char_length(entity_id) > 0]]></string>
			</constraint>
			<constraint name="metadata_url not empty" type="CHECK" options="" >
				<string><![CDATA[metadata_url = NULL::text) OR (char_length(metadata_url) > 0]]></string>
			</constraint>
			<constraint name="metadata_xml not empty" type="CHECK" options="" >
				<string><![CDATA[char_length(metadata_xml) > 0]]></string>
			</constraint>
			<fk name="saml_providers_sso_provider_id_fkey" to_schema="postgres.auth" to_table="sso_providers" delete_action="cascade" options="" >
				<fk_column name="sso_provider_id" pk="id" />
			</fk>
		</table>
		<table name="saml_relay_states" row_count="0" spec="" >
			<comment><![CDATA[Auth: Contains SAML Relay State information for each Service Provider initiated login.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="sso_provider_id" type="uuid" mandatory="y" />
			<column name="request_id" type="text" mandatory="y" />
			<column name="for_email" type="text" />
			<column name="redirect_to" type="text" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="flow_state_id" type="uuid" />
			<index name="saml_relay_states_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="saml_relay_states_sso_provider_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="sso_provider_id" />
			</index>
			<index name="saml_relay_states_for_email_idx" unique="NORMAL" spec="USING  btree" >
				<column name="for_email" />
			</index>
			<index name="saml_relay_states_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="created_at" options=" DESC" />
			</index>
			<constraint name="request_id not empty" type="CHECK" options="" >
				<string><![CDATA[char_length(request_id) > 0]]></string>
			</constraint>
			<fk name="saml_relay_states_sso_provider_id_fkey" to_schema="postgres.auth" to_table="sso_providers" delete_action="cascade" options="" >
				<fk_column name="sso_provider_id" pk="id" />
			</fk>
			<fk name="saml_relay_states_flow_state_id_fkey" to_schema="postgres.auth" to_table="flow_state" delete_action="cascade" options="" >
				<fk_column name="flow_state_id" pk="id" />
			</fk>
		</table>
		<table name="schema_migrations" row_count="76" spec="" >
			<comment><![CDATA[Auth: Manages updates to the auth system.]]></comment>
			<column name="version" type="varchar" length="255" mandatory="y" />
			<index name="schema_migrations_pkey" unique="PRIMARY_KEY" >
				<column name="version" />
			</index>
		</table>
		<table name="sessions" row_count="0" spec="" >
			<comment><![CDATA[Auth: Stores session data associated to a user.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="user_id" type="uuid" mandatory="y" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="factor_id" type="uuid" />
			<column name="aal" type="aal_level" />
			<column name="not_after" type="timestamptz" >
				<comment><![CDATA[Auth: Not after is a nullable column that contains a timestamp after which the session should be regarded as expired.]]></comment>
			</column>
			<column name="refreshed_at" type="timestamp" />
			<column name="user_agent" type="text" />
			<column name="ip" type="inet" />
			<column name="tag" type="text" />
			<column name="oauth_client_id" type="uuid" />
			<column name="refresh_token_hmac_key" type="text" >
				<comment><![CDATA[Holds a HMAC-SHA256 key used to sign refresh tokens for this session.]]></comment>
			</column>
			<column name="refresh_token_counter" type="bigint" >
				<comment><![CDATA[Holds the ID (counter) of the last issued refresh token.]]></comment>
			</column>
			<column name="scopes" type="text" />
			<index name="sessions_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="user_id_created_at_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
				<column name="created_at" />
			</index>
			<index name="sessions_user_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="user_id" />
			</index>
			<index name="sessions_not_after_idx" unique="NORMAL" spec="USING  btree" >
				<column name="not_after" options=" DESC" />
			</index>
			<index name="sessions_oauth_client_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="oauth_client_id" />
			</index>
			<constraint name="sessions_scopes_length" type="CHECK" options="" >
				<string><![CDATA[char_length(scopes) <= 4096]]></string>
			</constraint>
			<fk name="sessions_user_id_fkey" to_schema="postgres.auth" to_table="users" delete_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="sessions_oauth_client_id_fkey" to_schema="postgres.auth" to_table="oauth_clients" delete_action="cascade" options="" >
				<fk_column name="oauth_client_id" pk="id" />
			</fk>
		</table>
		<table name="sso_domains" row_count="0" spec="" >
			<comment><![CDATA[Auth: Manages SSO email address domain mapping to an SSO Identity Provider.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="sso_provider_id" type="uuid" mandatory="y" />
			<column name="domain" type="text" mandatory="y" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="lower(domain)" type="text" spec="functional" />
			<index name="sso_domains_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="sso_domains_sso_provider_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="sso_provider_id" />
			</index>
			<index name="sso_domains_domain_idx" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="lower(domain)" />
			</index>
			<constraint name="domain not empty" type="CHECK" options="" >
				<string><![CDATA[char_length(domain) > 0]]></string>
			</constraint>
			<fk name="sso_domains_sso_provider_id_fkey" to_schema="postgres.auth" to_table="sso_providers" delete_action="cascade" options="" >
				<fk_column name="sso_provider_id" pk="id" />
			</fk>
		</table>
		<table name="sso_providers" row_count="0" spec="" >
			<comment><![CDATA[Auth: Manages SSO identity provider information; see saml_providers for SAML.]]></comment>
			<column name="id" type="uuid" mandatory="y" />
			<column name="resource_id" type="text" >
				<comment><![CDATA[Auth: Uniquely identifies a SSO provider according to a user-chosen resource ID (case insensitive), useful in infrastructure as code.]]></comment>
			</column>
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="disabled" type="boolean" />
			<column name="lower(resource_id)" type="text" spec="functional" />
			<index name="sso_providers_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="sso_providers_resource_id_idx" unique="UNIQUE_INDEX" spec="USING  btree" >
				<column name="lower(resource_id)" />
			</index>
			<index name="sso_providers_resource_id_pattern_idx" unique="NORMAL" spec="USING  btree" >
				<column name="resource_id" options=" text_pattern_ops" />
			</index>
			<constraint name="resource_id not empty" type="CHECK" options="" >
				<string><![CDATA[resource_id = NULL::text) OR (char_length(resource_id) > 0]]></string>
			</constraint>
		</table>
		<table name="users" row_count="0" spec="" >
			<comment><![CDATA[Auth: Stores user login data within a secure schema.]]></comment>
			<column name="instance_id" type="uuid" />
			<column name="id" type="uuid" mandatory="y" />
			<column name="aud" type="varchar" length="255" />
			<column name="role" type="varchar" length="255" />
			<column name="email" type="varchar" length="255" />
			<column name="encrypted_password" type="varchar" length="255" />
			<column name="email_confirmed_at" type="timestamptz" />
			<column name="invited_at" type="timestamptz" />
			<column name="confirmation_token" type="varchar" length="255" />
			<column name="confirmation_sent_at" type="timestamptz" />
			<column name="recovery_token" type="varchar" length="255" />
			<column name="recovery_sent_at" type="timestamptz" />
			<column name="email_change_token_new" type="varchar" length="255" />
			<column name="email_change" type="varchar" length="255" />
			<column name="email_change_sent_at" type="timestamptz" />
			<column name="last_sign_in_at" type="timestamptz" />
			<column name="raw_app_meta_data" type="jsonb" >
				<column name="provider" type="_string" virtual="y" />
				<column name="providers" type="_array" content_type="JSON_ARRAY" virtual="y" />
			</column>
			<column name="raw_user_meta_data" type="jsonb" >
				<column name="email_verified" type="_boolean" virtual="y" />
			</column>
			<column name="is_super_admin" type="boolean" />
			<column name="created_at" type="timestamptz" />
			<column name="updated_at" type="timestamptz" />
			<column name="phone" type="text" >
				<defo><![CDATA[NULL::character varying]]></defo>
			</column>
			<column name="phone_confirmed_at" type="timestamptz" />
			<column name="phone_change" type="text" >
				<defo><![CDATA[''::character varying]]></defo>
			</column>
			<column name="phone_change_token" type="varchar" length="255" >
				<defo><![CDATA[''::character varying]]></defo>
			</column>
			<column name="phone_change_sent_at" type="timestamptz" />
			<column name="confirmed_at" type="timestamptz" >
				<column_options><![CDATA[GENERATED ALWAYS AS (LEAST(email_confirmed_at, phone_confirmed_at)) STORED]]></column_options>
			</column>
			<column name="email_change_token_current" type="varchar" length="255" >
				<defo><![CDATA[''::character varying]]></defo>
			</column>
			<column name="email_change_confirm_status" type="smallint" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="banned_until" type="timestamptz" />
			<column name="reauthentication_token" type="varchar" length="255" >
				<defo><![CDATA[''::character varying]]></defo>
			</column>
			<column name="reauthentication_sent_at" type="timestamptz" />
			<column name="is_sso_user" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
				<comment><![CDATA[Auth: Set this column to true when the account comes from SSO. These accounts can have duplicate emails.]]></comment>
			</column>
			<column name="deleted_at" type="timestamptz" />
			<column name="is_anonymous" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="lower((email)::text)" type="text" spec="functional" />
			<column name="raw_user_meta_data -&gt;&gt; &#039;name&#039;::text" type="text" spec="functional" />
			<index name="users_pkey" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="users_phone_key" unique="UNIQUE_KEY" >
				<column name="phone" />
			</index>
			<index name="users_instance_id_idx" unique="NORMAL" spec="USING  btree" >
				<column name="instance_id" />
			</index>
			<index name="users_instance_id_email_idx" unique="NORMAL" spec="USING  btree" >
				<column name="instance_id" />
				<column name="lower((email)::text)" />
			</index>
			<index name="confirmation_token_idx" unique="UNIQUE_INDEX" spec="USING  btree" options="WHERE ((confirmation_token)::text !~ &#039;^[0-9 ]*$&#039;::text)" >
				<column name="confirmation_token" />
			</index>
			<index name="recovery_token_idx" unique="UNIQUE_INDEX" spec="USING  btree" options="WHERE ((recovery_token)::text !~ &#039;^[0-9 ]*$&#039;::text)" >
				<column name="recovery_token" />
			</index>
			<index name="email_change_token_current_idx" unique="UNIQUE_INDEX" spec="USING  btree" options="WHERE ((email_change_token_current)::text !~ &#039;^[0-9 ]*$&#039;::text)" >
				<column name="email_change_token_current" />
			</index>
			<index name="email_change_token_new_idx" unique="UNIQUE_INDEX" spec="USING  btree" options="WHERE ((email_change_token_new)::text !~ &#039;^[0-9 ]*$&#039;::text)" >
