		<view name="pending_agent_participation" >
			<comment><![CDATA[One row per current pending listing per listing-side primary or co-agent.]]></comment>
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH agent_counts AS (
         SELECT d_1.invntry_snap_ky,
            (
                CASE
                    WHEN (d_1.listing_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END +
                CASE
                    WHEN (d_1.listing_co_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END) AS listing_agent_count
           FROM internal.pending_snapshot_detail d_1)
 SELECT d.invntry_snap_ky,
    d.invntry_snap_date_ky,
    d.snapshot_dt,
    d.lstng_ky,
    d.prprty_ky,
    d.lstng_nb,
    d.stts_cd,
    d.zone_nm,
    d.area_nm,
    d.community_nm,
    d.development_nm,
    d.building_nm,
    d.property_address_ds,
    d.unit_id,
    d.property_type_ds,
    d.prprty_type_cd,
    d.bdrm_nb,
    d.full_bthrm_nb,
    d.half_bthrm_nb,
    d.m2_cnstrctn_nb,
    d.ft2_cnstrctn_nb,
    d.pre_cnstrctn_fl,
    d.market_type_nm,
    'LISTING'::text AS transaction_side_cd,
    a.agent_role_cd,
    a.agency_nm,
    a.agent_nm,
    a.agency_inferred_fl,
    (1)::numeric AS participation_count,
    ((1)::numeric / (NULLIF(cnt.listing_agent_count, 0))::numeric) AS allocated_side_credit,
    d.original_list_price_usd,
    d.current_list_price_usd,
    d.current_list_price_usd AS participating_volume_usd,
    (d.current_list_price_usd / (NULLIF(cnt.listing_agent_count, 0))::numeric) AS allocated_volume_usd,
    d.current_price_per_m2_usd,
    d.current_price_per_ft2_usd,
    d.current_dom_nb,
    d.price_change_from_original_usd,
    d.price_change_from_original_pc
   FROM ((internal.pending_snapshot_detail d
     JOIN agent_counts cnt ON ((cnt.invntry_snap_ky = d.invntry_snap_ky)))
     CROSS JOIN LATERAL ( VALUES ('PRIMARY'::text,d.listing_agency_nm,d.listing_agent_nm,false), ('CO-AGENT'::text,d.listing_agency_nm,d.listing_co_agent_nm,true)) a(agent_role_cd, agency_nm, agent_nm, agency_inferred_fl))
  WHERE (a.agent_nm IS NOT NULL)]]></view_script>
			<column name="invntry_snap_ky" type="bigint" />
			<column name="invntry_snap_date_ky" type="integer" />
			<column name="snapshot_dt" type="date" />
			<column name="lstng_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_nb" type="bigint" />
			<column name="stts_cd" type="text" />
			<column name="zone_nm" type="text" />
			<column name="area_nm" type="text" />
			<column name="community_nm" type="text" />
			<column name="development_nm" type="text" />
			<column name="building_nm" type="text" />
