		<view name="closed_listing" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS WITH base AS (
         SELECT cs.clsd_sale_ky,
            cs.prprty_ky,
            cs.lstng_ky,
            l.lstng_nb AS mls,
            p.zone_ds AS zone_name,
            p.area_ds AS area_name,
            p.cmnty_ds AS community_name,
            p.dvlpmnt_ds AS development_name,
            p.adrs_ds AS address,
            p.prprty_type,
            l.prprty_type_cd,
            l.bdrm_nb AS beds,
            l.full_bthrm_nb AS baths,
            l.ft2_cnstrctn_nb AS sqft,
            l.m2_cnstrctn_nb AS sqm,
                CASE
                    WHEN (cs.pre_cnstrctn_fl = true) THEN 'pre_construction'::text
                    ELSE 'resale'::text
                END AS market_segment,
                CASE
                    WHEN (p.prprty_type = 'Houses'::text) THEN 'houses'::text
                    WHEN (p.prprty_type = 'Condos'::text) THEN 'condos'::text
                    ELSE 'all'::text
                END AS property_type_segment,
                CASE
                    WHEN (COALESCE(l.bdrm_nb, (0)::numeric) = (0)::numeric) THEN '0br'::text
                    WHEN (l.bdrm_nb = (1)::numeric) THEN '1br'::text
                    WHEN (l.bdrm_nb = (2)::numeric) THEN '2br'::text
                    ELSE '3br_plus'::text
                END AS bedroom_segment,
            cs.sold_date_ky,
            to_date((cs.sold_date_ky)::text, 'YYYYMMDD'::text) AS sold_date,
            cs.orgnl_prc_am AS original_list_price,
            cs.list_prc_am AS final_list_price,
            cs.sold_prc_am AS sold_price,
            cs.sold_minus_list_am AS sold_minus_final_list,
            cs.sold_to_list_pc AS sold_to_final_list_ratio,
            cs.sold_minus_orgnl_am AS sold_minus_original_list,
            cs.sold_to_orgnl_pc AS sold_to_original_list_ratio,
            cs.sold_prc_ft2_am AS sold_price_per_sqft,
            cs.sold_prc_m2_am AS sold_price_per_sqm,
            cs.dom_nb AS days_on_market,
            cs.pre_cnstrctn_fl AS pre_construction,
            cs.run_ts AS data_current_as_of
           FROM ((dw.clsd_sale cs
             JOIN dw.lstng l ON ((cs.lstng_ky = l.lstng_ky)))
             JOIN dw.prprty p ON ((cs.prprty_ky = p.prprty_ky)))
        ), joined AS (
         SELECT b.clsd_sale_ky,
            b.prprty_ky,
            b.lstng_ky,
            b.mls,
            b.zone_name,
            b.area_name,
            b.community_name,
            b.development_name,
            b.address,
            b.prprty_type,
            b.prprty_type_cd,
            b.beds,
            b.baths,
            b.sqft,
            b.sqm,
            b.market_segment,
            b.property_type_segment,
            b.bedroom_segment,
            b.sold_date_ky,
            b.sold_date,
            b.original_list_price,
            b.final_list_price,
            b.sold_price,
            b.sold_minus_final_list,
            b.sold_to_final_list_ratio,
            b.sold_minus_original_list,
            b.sold_to_original_list_ratio,
            b.sold_price_per_sqft,
            b.sold_price_per_sqm,
            b.days_on_market,
            b.pre_construction,
            b.data_current_as_of,
            cs.snapshot_date AS market_snapshot_date,
            cs.sales_period_start AS market_sales_period_start,
            cs.sales_period_end AS market_sales_period_end,
            cs.active_count AS community_active_count,
            cs.pending_count AS community_pending_count,
            cs.sales_12mo AS community_sales_12mo,
            cs.median_sold_price AS community_median_sold_price,
            cs.median_sold_price_ft2 AS community_median_sold_price_sqft,
            cs.months_inventory AS community_months_inventory,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.median_sold_price_0br
                    WHEN '1br'::text THEN cs.median_sold_price_1br
                    WHEN '2br'::text THEN cs.median_sold_price_2br
                    ELSE cs.median_sold_price_3br_plus
                END AS community_bedroom_median_sold_price,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.median_sold_price_ft2_0br
                    WHEN '1br'::text THEN cs.median_sold_price_ft2_1br
                    WHEN '2br'::text THEN cs.median_sold_price_ft2_2br
                    ELSE cs.median_sold_price_ft2_3br_plus
                END AS community_bedroom_median_sold_price_sqft,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.months_inventory_0br
                    WHEN '1br'::text THEN cs.months_inventory_1br
                    WHEN '2br'::text THEN cs.months_inventory_2br
                    ELSE cs.months_inventory_3br_plus
                END AS community_bedroom_months_inventory,
            ds.active_count AS development_active_count,
            ds.pending_count AS development_pending_count,
            ds.sales_12mo AS development_sales_12mo,
            ds.median_sold_price AS development_median_sold_price,
            ds.median_sold_price_ft2 AS development_median_sold_price_sqft,
            ds.months_inventory AS development_months_inventory
           FROM ((base b
             LEFT JOIN community_snapshot cs ON (((cs.zone_name = b.zone_name) AND (cs.area_name = b.area_name) AND (cs.community_name = b.community_name) AND (cs.market_segment = b.market_segment) AND (cs.property_type_segment = b.property_type_segment))))
             LEFT JOIN development_snapshot ds ON (((ds.zone_name = b.zone_name) AND (ds.area_name = b.area_name) AND (ds.community_name = b.community_name) AND (ds.development_name = b.development_name) AND (ds.market_segment = b.market_segment) AND (ds.property_type_segment = b.property_type_segment))))
        )
 SELECT clsd_sale_ky,
    prprty_ky,
    lstng_ky,
    mls,
    zone_name,
    area_name,
    community_name,
    development_name,
    address,
    prprty_type,
    prprty_type_cd,
    beds,
    baths,
    sqft,
    sqm,
    market_segment,
    property_type_segment,
    bedroom_segment,
    sold_date_ky,
    sold_date,
    original_list_price,
    final_list_price,
    sold_price,
    sold_minus_final_list,
    sold_to_final_list_ratio,
    sold_minus_original_list,
    sold_to_original_list_ratio,
    sold_price_per_sqft,
    sold_price_per_sqm,
    days_on_market,
    pre_construction,
    data_current_as_of,
    market_snapshot_date,
    market_sales_period_start,
    market_sales_period_end,
    community_active_count,
    community_pending_count,
    community_sales_12mo,
    community_median_sold_price,
    community_median_sold_price_sqft,
    community_months_inventory,
    community_bedroom_median_sold_price,
    community_bedroom_median_sold_price_sqft,
    community_bedroom_months_inventory,
    development_active_count,
    development_pending_count,
    development_sales_12mo,
    development_median_sold_price,
    development_median_sold_price_sqft,
    development_months_inventory,
        CASE
            WHEN (final_list_price > (0)::numeric) THEN (final_list_price - sold_price)
            ELSE NULL::numeric
        END AS discount_from_final_list,
        CASE
            WHEN (final_list_price > (0)::numeric) THEN round((((final_list_price - sold_price) / final_list_price) * (100)::numeric), 1)
            ELSE NULL::numeric
        END AS discount_from_final_list_pct,
        CASE
            WHEN (original_list_price > (0)::numeric) THEN (original_list_price - sold_price)
            ELSE NULL::numeric
        END AS discount_from_original_list,
        CASE
            WHEN (original_list_price > (0)::numeric) THEN round((((original_list_price - sold_price) / original_list_price) * (100)::numeric), 1)
            ELSE NULL::numeric
        END AS discount_from_original_list_pct,
    round((sold_to_final_list_ratio * (100)::numeric), 1) AS sold_to_final_list_pct,
    round((sold_to_original_list_ratio * (100)::numeric), 1) AS sold_to_original_list_pct,
        CASE
            WHEN (community_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / community_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_community_median_pct,
        CASE
            WHEN (community_median_sold_price_sqft > (0)::double precision) THEN round((((((sold_price_per_sqft)::double precision / community_median_sold_price_sqft) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_sqft_vs_community_median_pct,
        CASE
            WHEN (community_bedroom_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / community_bedroom_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_bedroom_median_pct,
        CASE
            WHEN (development_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / development_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_development_median_pct,
        CASE
            WHEN (development_median_sold_price_sqft > (0)::double precision) THEN round((((((sold_price_per_sqft)::double precision / development_median_sold_price_sqft) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_sqft_vs_development_median_pct
   FROM joined]]></view_script>
			<column name="clsd_sale_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_ky" type="bigint" />
			<column name="mls" type="bigint" />
			<column name="zone_name" type="text" />
			<column name="area_name" type="text" />
			<column name="community_name" type="text" />
			<column name="development_name" type="text" />
			<column name="address" type="text" />
			<column name="prprty_type" type="text" />
			<column name="prprty_type_cd" type="text" />
			<column name="beds" type="numeric" />
			<column name="baths" type="numeric" />
			<column name="sqft" type="numeric" />
			<column name="sqm" type="numeric" />
			<column name="market_segment" type="text" />
			<column name="property_type_segment" type="text" />
			<column name="bedroom_segment" type="text" />
			<column name="sold_date_ky" type="integer" />
			<column name="sold_date" type="date" />
			<column name="original_list_price" type="numeric" />
			<column name="final_list_price" type="numeric" />
			<column name="sold_price" type="numeric" />
			<column name="sold_minus_final_list" type="numeric" />
			<column name="sold_to_final_list_ratio" type="numeric" />
			<column name="sold_minus_original_list" type="numeric" />
			<column name="sold_to_original_list_ratio" type="numeric" />
			<column name="sold_price_per_sqft" type="numeric" />
			<column name="sold_price_per_sqm" type="numeric" />
			<column name="days_on_market" type="integer" />
			<column name="pre_construction" type="boolean" />
			<column name="data_current_as_of" type="text" />
			<column name="market_snapshot_date" type="date" />
			<column name="market_sales_period_start" type="date" />
			<column name="market_sales_period_end" type="date" />
			<column name="community_active_count" type="bigint" />
			<column name="community_pending_count" type="bigint" />
			<column name="community_sales_12mo" type="bigint" />
			<column name="community_median_sold_price" type="double precision" />
			<column name="community_median_sold_price_sqft" type="double precision" />
			<column name="community_months_inventory" type="numeric" />
			<column name="community_bedroom_median_sold_price" type="double precision" />
			<column name="community_bedroom_median_sold_price_sqft" type="double precision" />
			<column name="community_bedroom_months_inventory" type="numeric" />
			<column name="development_active_count" type="bigint" />
			<column name="development_pending_count" type="bigint" />
			<column name="development_sales_12mo" type="bigint" />
			<column name="development_median_sold_price" type="double precision" />
			<column name="development_median_sold_price_sqft" type="double precision" />
			<column name="development_months_inventory" type="numeric" />
			<column name="discount_from_final_list" type="numeric" />
			<column name="discount_from_final_list_pct" type="numeric" />
			<column name="discount_from_original_list" type="numeric" />
			<column name="discount_from_original_list_pct" type="numeric" />
			<column name="sold_to_final_list_pct" type="numeric" />
			<column name="sold_to_original_list_pct" type="numeric" />
			<column name="sold_price_vs_community_median_pct" type="numeric" />
			<column name="sold_price_sqft_vs_community_median_pct" type="numeric" />
			<column name="sold_price_vs_bedroom_median_pct" type="numeric" />
			<column name="sold_price_vs_development_median_pct" type="numeric" />
			<column name="sold_price_sqft_vs_development_median_pct" type="numeric" />
		</view>
		<view name="closed_listing_detail" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS WITH base AS (
         SELECT closed_listing_list.clsd_sale_ky,
            closed_listing_list.prprty_ky,
            closed_listing_list.lstng_ky,
            closed_listing_list.mls,
            closed_listing_list.zone_name,
            closed_listing_list.area_name,
            closed_listing_list.community_name,
            closed_listing_list.development_name,
            closed_listing_list.address,
            closed_listing_list.prprty_type,
            closed_listing_list.prprty_type_cd,
            closed_listing_list.beds,
            closed_listing_list.baths,
            closed_listing_list.sqft,
            closed_listing_list.sqm,
            closed_listing_list.market_segment,
            closed_listing_list.property_type_segment,
            closed_listing_list.bedroom_segment,
            closed_listing_list.sold_date_ky,
            closed_listing_list.sold_date,
            closed_listing_list.original_list_price,
            closed_listing_list.final_list_price,
            closed_listing_list.sold_price,
            closed_listing_list.sold_to_final_list_pct,
            closed_listing_list.sold_to_original_list_pct,
            closed_listing_list.sold_price_per_sqft,
            closed_listing_list.sold_price_per_sqm,
            closed_listing_list.days_on_market,
            closed_listing_list.pre_construction,
            closed_listing_list.data_current_as_of,
            closed_listing_list.unit
           FROM closed_listing_list
        ), joined AS (
         SELECT b.clsd_sale_ky,
            b.prprty_ky,
            b.lstng_ky,
            b.mls,
            b.zone_name,
            b.area_name,
            b.community_name,
            b.development_name,
            b.address,
            b.prprty_type,
            b.prprty_type_cd,
            b.beds,
            b.baths,
            b.sqft,
            b.sqm,
            b.market_segment,
            b.property_type_segment,
            b.bedroom_segment,
            b.sold_date_ky,
            b.sold_date,
            b.original_list_price,
            b.final_list_price,
            b.sold_price,
            b.sold_to_final_list_pct,
            b.sold_to_original_list_pct,
            b.sold_price_per_sqft,
            b.sold_price_per_sqm,
            b.days_on_market,
            b.pre_construction,
            b.data_current_as_of,
            b.unit,
            cs.snapshot_date AS market_snapshot_date,
            cs.sales_period_start AS market_sales_period_start,
            cs.sales_period_end AS market_sales_period_end,
            cs.active_count AS community_active_count,
            cs.pending_count AS community_pending_count,
            cs.sales_12mo AS community_sales_12mo,
            cs.median_sold_price AS community_median_sold_price,
            cs.median_sold_price_ft2 AS community_median_sold_price_sqft,
            cs.months_inventory AS community_months_inventory,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.median_sold_price_0br
                    WHEN '1br'::text THEN cs.median_sold_price_1br
                    WHEN '2br'::text THEN cs.median_sold_price_2br
                    ELSE cs.median_sold_price_3br_plus
                END AS community_bedroom_median_sold_price,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.median_sold_price_ft2_0br
                    WHEN '1br'::text THEN cs.median_sold_price_ft2_1br
                    WHEN '2br'::text THEN cs.median_sold_price_ft2_2br
                    ELSE cs.median_sold_price_ft2_3br_plus
                END AS community_bedroom_median_sold_price_sqft,
                CASE b.bedroom_segment
                    WHEN '0br'::text THEN cs.months_inventory_0br
                    WHEN '1br'::text THEN cs.months_inventory_1br
                    WHEN '2br'::text THEN cs.months_inventory_2br
                    ELSE cs.months_inventory_3br_plus
                END AS community_bedroom_months_inventory,
            ds.active_count AS development_active_count,
            ds.pending_count AS development_pending_count,
            ds.sales_12mo AS development_sales_12mo,
            ds.median_sold_price AS development_median_sold_price,
            ds.median_sold_price_ft2 AS development_median_sold_price_sqft,
            ds.months_inventory AS development_months_inventory
           FROM ((base b
             LEFT JOIN community_snapshot cs ON (((cs.zone_name = b.zone_name) AND (cs.area_name = b.area_name) AND (cs.community_name = b.community_name) AND (cs.market_segment = b.market_segment) AND (cs.property_type_segment = b.property_type_segment))))
             LEFT JOIN development_snapshot ds ON (((ds.zone_name = b.zone_name) AND (ds.area_name = b.area_name) AND (ds.community_name = b.community_name) AND (ds.development_name = b.development_name) AND (ds.market_segment = b.market_segment) AND (ds.property_type_segment = b.property_type_segment))))
        )
 SELECT clsd_sale_ky,
    prprty_ky,
    lstng_ky,
    mls,
    zone_name,
    area_name,
    community_name,
    development_name,
    address,
    prprty_type,
    prprty_type_cd,
    beds,
    baths,
    sqft,
    sqm,
    market_segment,
    property_type_segment,
    bedroom_segment,
    sold_date_ky,
    sold_date,
    original_list_price,
    final_list_price,
    sold_price,
    sold_to_final_list_pct,
    sold_to_original_list_pct,
    sold_price_per_sqft,
    sold_price_per_sqm,
    days_on_market,
    pre_construction,
    data_current_as_of,
    unit,
    market_snapshot_date,
    market_sales_period_start,
    market_sales_period_end,
    community_active_count,
    community_pending_count,
    community_sales_12mo,
    community_median_sold_price,
    community_median_sold_price_sqft,
    community_months_inventory,
    community_bedroom_median_sold_price,
    community_bedroom_median_sold_price_sqft,
    community_bedroom_months_inventory,
    development_active_count,
    development_pending_count,
    development_sales_12mo,
    development_median_sold_price,
    development_median_sold_price_sqft,
    development_months_inventory,
        CASE
            WHEN (final_list_price > (0)::numeric) THEN (final_list_price - sold_price)
            ELSE NULL::numeric
        END AS discount_from_final_list,
        CASE
            WHEN (final_list_price > (0)::numeric) THEN round((((final_list_price - sold_price) / final_list_price) * (100)::numeric), 1)
            ELSE NULL::numeric
        END AS discount_from_final_list_pct,
        CASE
            WHEN (original_list_price > (0)::numeric) THEN (original_list_price - sold_price)
            ELSE NULL::numeric
        END AS discount_from_original_list,
        CASE
            WHEN (original_list_price > (0)::numeric) THEN round((((original_list_price - sold_price) / original_list_price) * (100)::numeric), 1)
            ELSE NULL::numeric
        END AS discount_from_original_list_pct,
        CASE
            WHEN (community_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / community_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_community_median_pct,
        CASE
            WHEN (community_median_sold_price_sqft > (0)::double precision) THEN round((((((sold_price_per_sqft)::double precision / community_median_sold_price_sqft) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_sqft_vs_community_median_pct,
        CASE
            WHEN (community_bedroom_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / community_bedroom_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_bedroom_median_pct,
        CASE
            WHEN (development_median_sold_price > (0)::double precision) THEN round((((((sold_price)::double precision / development_median_sold_price) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_vs_development_median_pct,
        CASE
            WHEN (development_median_sold_price_sqft > (0)::double precision) THEN round((((((sold_price_per_sqft)::double precision / development_median_sold_price_sqft) - (1)::double precision) * (100)::double precision))::numeric, 1)
            ELSE NULL::numeric
        END AS sold_price_sqft_vs_development_median_pct
   FROM joined]]></view_script>
			<column name="clsd_sale_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_ky" type="bigint" />
