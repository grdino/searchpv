			<column name="prprty_type_cd" type="text" />
			<column name="bdrm_nb" type="numeric" />
			<column name="full_bthrm_nb" type="numeric" />
			<column name="half_bthrm_nb" type="numeric" />
			<column name="m2_cnstrctn_nb" type="numeric" />
			<column name="ft2_cnstrctn_nb" type="numeric" />
			<column name="pre_cnstrctn_fl" type="boolean" />
			<column name="market_type_nm" type="text" />
			<column name="transaction_side_cd" type="text" />
			<column name="agent_role_cd" type="text" />
			<column name="agency_nm" type="text" />
			<column name="agent_nm" type="text" />
			<column name="agency_inferred_fl" type="boolean" />
			<column name="participation_count" type="numeric" />
			<column name="allocated_side_credit" type="numeric" />
			<column name="original_list_price_usd" type="numeric" />
			<column name="current_list_price_usd" type="numeric" />
			<column name="participating_volume_usd" type="numeric" />
			<column name="allocated_volume_usd" type="numeric" />
			<column name="current_price_per_m2_usd" type="numeric" />
			<column name="current_price_per_ft2_usd" type="numeric" />
			<column name="current_dom_nb" type="integer" />
			<column name="price_change_from_original_usd" type="numeric" />
			<column name="price_change_from_original_pc" type="numeric" />
		</view>
		<view name="pending_snapshot_detail" >
			<comment><![CDATA[One row per pending listing from the latest inventory snapshot; no pending-event date is implied.]]></comment>
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH latest_snapshot_date AS (
         SELECT max(i_1.invntry_snap_date_ky) AS invntry_snap_date_ky
           FROM dw.invntry_snap i_1), latest_listing_rows AS (
         SELECT i_1.invntry_snap_ky,
            i_1.invntry_snap_date_ky,
            i_1.prprty_ky,
            i_1.lstng_ky,
            i_1.stts_cd,
            i_1.snap_list_prc_am,
            i_1.orgnl_list_prc_am,
            i_1.prc_ft2_qt,
            i_1.prc_m2_qt,
            i_1.dom_qt,
            i_1.extrct_rnge_id,
            i_1.btch_id,
            i_1.run_ts,
            i_1.load_ts,
            i_1.pre_cnstrctn_fl,
            row_number() OVER (PARTITION BY i_1.lstng_ky ORDER BY i_1.run_ts DESC NULLS LAST, i_1.load_ts DESC NULLS LAST, i_1.invntry_snap_ky DESC) AS listing_row_nb
           FROM (dw.invntry_snap i_1
             JOIN latest_snapshot_date d ON ((d.invntry_snap_date_ky = i_1.invntry_snap_date_ky))))
 SELECT i.invntry_snap_ky,
    i.invntry_snap_date_ky,
    c.full_dt AS snapshot_dt,
    i.lstng_ky,
    i.prprty_ky,
    l.lstng_nb,
    i.stts_cd,
    p.zone_ds AS zone_nm,
    p.area_ds AS area_nm,
    p.cmnty_ds AS community_nm,
    p.dvlpmnt_ds AS development_nm,
    p.bldng_ds AS building_nm,
    p.prprty_fngrprnt_id,
    p.tax_id,
    p.adrs_ds AS property_address_ds,
    p.unit_id,
    p.prprty_type AS property_type_ds,
    p.lat_nb,
    p.long_nb,
    l.adrs_strt_nm,
    l.adrs_city_nm,
    l.adrs_st_nm,
    l.adrs_zip_cd,
    l.adrs_lngtd_nb,
    l.adrs_lttd_nb,
    l.prprty_type_cd,
    l.bdrm_nb,
    l.full_bthrm_nb,
    l.half_bthrm_nb,
    l.m2_lot_nb,
    l.ft2_lot_nb,
    l.m2_cnstrctn_nb,
    l.ft2_cnstrctn_nb,
    l.year_blt_dt,
    l.flr_nb,
    l.prmy_view_nm,
    l.scndry_view_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_agncy_ds), ''::text) AS listing_agency_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_agnt_nm), ''::text) AS listing_agent_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_co_agnt_nm), ''::text) AS listing_co_agent_nm,
    i.orgnl_list_prc_am AS original_list_price_usd,
    i.snap_list_prc_am AS current_list_price_usd,
    i.prc_m2_qt AS current_price_per_m2_usd,
    i.prc_ft2_qt AS current_price_per_ft2_usd,
    i.dom_qt AS current_dom_nb,
        CASE
            WHEN ((i.orgnl_list_prc_am IS NULL) OR (i.snap_list_prc_am IS NULL)) THEN NULL::numeric
            ELSE (i.snap_list_prc_am - i.orgnl_list_prc_am)
        END AS price_change_from_original_usd,
        CASE
            WHEN ((i.orgnl_list_prc_am IS NULL) OR (i.orgnl_list_prc_am = (0)::numeric) OR (i.snap_list_prc_am IS NULL)) THEN NULL::numeric
            ELSE round((((i.snap_list_prc_am - i.orgnl_list_prc_am) / i.orgnl_list_prc_am) * (100)::numeric), 4)
        END AS price_change_from_original_pc,
    i.pre_cnstrctn_fl,
        CASE
            WHEN i.pre_cnstrctn_fl THEN 'PRE-CONSTRUCTION'::text
            ELSE 'RESALE'::text
        END AS market_type_nm,
    i.extrct_rnge_id,
    i.btch_id,
    i.run_ts,
    i.load_ts
   FROM (((latest_listing_rows i
     JOIN dw.lstng l ON ((l.lstng_ky = i.lstng_ky)))
     JOIN dw.prprty p ON ((p.prprty_ky = i.prprty_ky)))
     JOIN dw.clndr c ON ((c.clndr_ky = i.invntry_snap_date_ky)))
  WHERE ((i.listing_row_nb = 1) AND (upper(TRIM(BOTH FROM i.stts_cd)) = 'P'::text))]]></view_script>
			<column name="invntry_snap_ky" type="bigint" />
			<column name="invntry_snap_date_ky" type="integer" />
			<column name="snapshot_dt" type="date" />
			<column name="lstng_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_nb" type="bigint" />
			<column name="stts_cd" type="text" />
