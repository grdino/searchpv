	<schema name="internal" catalogname="postgres" >
		<comment><![CDATA[Private brokerage reporting views. Not intended for anonymous/public access.]]></comment>
		<view name="closed_agent_participation" >
			<comment><![CDATA[One row per closed-sale agent participant, including primary and co-agents on listing and selling sides.]]></comment>
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS WITH side_agent_counts AS (
         SELECT d_1.clsd_sale_ky,
            (
                CASE
                    WHEN (d_1.listing_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END +
                CASE
                    WHEN (d_1.listing_co_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END) AS listing_agent_count,
            (
                CASE
                    WHEN (d_1.selling_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END +
                CASE
                    WHEN (d_1.selling_co_agent_nm IS NOT NULL) THEN 1
                    ELSE 0
                END) AS selling_agent_count
           FROM internal.closed_sales_detail d_1)
 SELECT d.clsd_sale_ky,
    d.lstng_ky,
    d.prprty_ky,
    d.lstng_nb,
    d.sold_date_ky,
    d.sold_dt,
    d.sold_year_nb,
    d.sold_quarter_nb,
    d.sold_month_nb,
    d.sold_month_nm,
    d.sold_month_abbr_nm,
    d.sold_year_month_id,
    d.zone_nm,
    d.area_nm,
    d.community_nm,
    d.development_nm,
    d.building_nm,
    d.property_address_ds,
    d.unit_id,
    d.property_type_ds,
    d.prprty_type_cd,
    d.bdrm_nb,
    d.full_bthrm_nb,
    d.half_bthrm_nb,
    d.m2_cnstrctn_nb,
    d.ft2_cnstrctn_nb,
    d.pre_cnstrctn_fl,
    d.market_type_nm,
    a.transaction_side_cd,
    a.agent_role_cd,
    a.agency_nm,
    a.agent_nm,
    a.agency_inferred_fl,
    (1)::numeric AS participation_count,
        CASE
            WHEN (a.transaction_side_cd = 'LISTING'::text) THEN ((1)::numeric / (NULLIF(cnt.listing_agent_count, 0))::numeric)
            WHEN (a.transaction_side_cd = 'SELLING'::text) THEN ((1)::numeric / (NULLIF(cnt.selling_agent_count, 0))::numeric)
            ELSE NULL::numeric
        END AS allocated_side_credit,
    d.original_price_usd,
    d.final_list_price_usd,
    d.sold_price_usd,
    d.sold_price_usd AS participating_volume_usd,
        CASE
            WHEN (a.transaction_side_cd = 'LISTING'::text) THEN (d.sold_price_usd / (NULLIF(cnt.listing_agent_count, 0))::numeric)
            WHEN (a.transaction_side_cd = 'SELLING'::text) THEN (d.sold_price_usd / (NULLIF(cnt.selling_agent_count, 0))::numeric)
            ELSE NULL::numeric
        END AS allocated_volume_usd,
    d.sold_minus_list_amount_usd,
    d.sold_to_list_pc,
    d.sold_vs_list_pc,
    d.sold_vs_list_category,
    d.sold_minus_original_amount_usd,
    d.sold_to_orgnl_pc,
    d.sold_vs_original_pc,
    d.sold_price_per_m2_usd,
    d.sold_price_per_ft2_usd,
    d.dom_nb
   FROM ((internal.closed_sales_detail d
     JOIN side_agent_counts cnt ON ((cnt.clsd_sale_ky = d.clsd_sale_ky)))
     CROSS JOIN LATERAL ( VALUES ('LISTING'::text,'PRIMARY'::text,d.listing_agency_nm,d.listing_agent_nm,false), ('LISTING'::text,'CO-AGENT'::text,d.listing_agency_nm,d.listing_co_agent_nm,true), ('SELLING'::text,'PRIMARY'::text,d.selling_agency_nm,d.selling_agent_nm,false), ('SELLING'::text,'CO-AGENT'::text,d.selling_agency_nm,d.selling_co_agent_nm,true)) a(transaction_side_cd, agent_role_cd, agency_nm, agent_nm, agency_inferred_fl))
  WHERE (a.agent_nm IS NOT NULL)]]></view_script>
			<column name="clsd_sale_ky" type="bigint" />
			<column name="lstng_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_nb" type="bigint" />
			<column name="sold_date_ky" type="integer" />
			<column name="sold_dt" type="date" />
			<column name="sold_year_nb" type="integer" />
			<column name="sold_quarter_nb" type="integer" />
			<column name="sold_month_nb" type="integer" />
			<column name="sold_month_nm" type="text" />
			<column name="sold_month_abbr_nm" type="text" />
			<column name="sold_year_month_id" type="text" />
			<column name="zone_nm" type="text" />
			<column name="area_nm" type="text" />
			<column name="community_nm" type="text" />
			<column name="development_nm" type="text" />
			<column name="building_nm" type="text" />
			<column name="property_address_ds" type="text" />
			<column name="unit_id" type="text" />
			<column name="property_type_ds" type="text" />
			<column name="prprty_type_cd" type="text" />
			<column name="bdrm_nb" type="numeric" />
			<column name="full_bthrm_nb" type="numeric" />
			<column name="half_bthrm_nb" type="numeric" />
			<column name="m2_cnstrctn_nb" type="numeric" />
			<column name="ft2_cnstrctn_nb" type="numeric" />
			<column name="pre_cnstrctn_fl" type="boolean" />
			<column name="market_type_nm" type="text" />
			<column name="transaction_side_cd" type="text" />
			<column name="agent_role_cd" type="text" />
			<column name="agency_nm" type="text" />
			<column name="agent_nm" type="text" />
			<column name="agency_inferred_fl" type="boolean" />
			<column name="participation_count" type="numeric" />
			<column name="allocated_side_credit" type="numeric" />
			<column name="original_price_usd" type="numeric" />
			<column name="final_list_price_usd" type="numeric" />
			<column name="sold_price_usd" type="numeric" />
			<column name="participating_volume_usd" type="numeric" />
			<column name="allocated_volume_usd" type="numeric" />
			<column name="sold_minus_list_amount_usd" type="numeric" />
			<column name="sold_to_list_pc" type="numeric" />
			<column name="sold_vs_list_pc" type="numeric" />
			<column name="sold_vs_list_category" type="text" />
			<column name="sold_minus_original_amount_usd" type="numeric" />
			<column name="sold_to_orgnl_pc" type="numeric" />
			<column name="sold_vs_original_pc" type="numeric" />
			<column name="sold_price_per_m2_usd" type="numeric" />
			<column name="sold_price_per_ft2_usd" type="numeric" />
			<column name="dom_nb" type="integer" />
		</view>
		<view name="closed_sales_detail" >
			<comment><![CDATA[One row per closed listing with date, geography, property, agency, agent and sales measures.]]></comment>
			<view_script><![CDATA[CREATE OR REPLACE VIEW ${view} AS SELECT cs.clsd_sale_ky,
    cs.lstng_ky,
    cs.prprty_ky,
    l.lstng_nb,
    cs.sold_date_ky,
    c.full_dt AS sold_dt,
    c.year_nb AS sold_year_nb,
    c.quarter_nb AS sold_quarter_nb,
    c.month_nb AS sold_month_nb,
    c.month_nm AS sold_month_nm,
    c.month_abbr_nm AS sold_month_abbr_nm,
    TRIM(BOTH FROM c.year_month_id) AS sold_year_month_id,
    c.month_start_dt AS sold_month_start_dt,
    c.month_end_dt AS sold_month_end_dt,
    c.quarter_start_dt AS sold_quarter_start_dt,
    c.quarter_end_dt AS sold_quarter_end_dt,
    c.year_start_dt AS sold_year_start_dt,
    c.year_end_dt AS sold_year_end_dt,
    p.zone_ds AS zone_nm,
    p.area_ds AS area_nm,
    p.cmnty_ds AS community_nm,
    p.dvlpmnt_ds AS development_nm,
    p.bldng_ds AS building_nm,
    p.prprty_fngrprnt_id,
    p.tax_id,
    p.adrs_ds AS property_address_ds,
    p.unit_id,
    p.prprty_type AS property_type_ds,
    p.lat_nb,
    p.long_nb,
    l.adrs_strt_nm,
    l.adrs_city_nm,
    l.adrs_st_nm,
    l.adrs_zip_cd,
    l.adrs_lngtd_nb,
    l.adrs_lttd_nb,
    l.prprty_type_cd,
    l.bdrm_nb,
    l.full_bthrm_nb,
    l.half_bthrm_nb,
    l.m2_lot_nb,
    l.ft2_lot_nb,
    l.m2_cnstrctn_nb,
    l.ft2_cnstrctn_nb,
    l.year_blt_dt,
    l.flr_nb,
    l.prmy_view_nm,
    l.scndry_view_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_agncy_ds), ''::text) AS listing_agency_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_agnt_nm), ''::text) AS listing_agent_nm,
    NULLIF(TRIM(BOTH FROM l.lstng_co_agnt_nm), ''::text) AS listing_co_agent_nm,
    NULLIF(TRIM(BOTH FROM l.buyer_agncy_nm), ''::text) AS selling_agency_nm,
    NULLIF(TRIM(BOTH FROM l.buyer_agnt_nm), ''::text) AS selling_agent_nm,
    NULLIF(TRIM(BOTH FROM l.buyer_co_agnt_nm), ''::text) AS selling_co_agent_nm,
    cs.orgnl_prc_am AS original_price_usd,
    cs.list_prc_am AS final_list_price_usd,
    cs.sold_prc_am AS sold_price_usd,
    cs.sold_minus_list_am AS sold_minus_list_amount_usd,
    cs.sold_to_list_pc,
        CASE
            WHEN ((cs.list_prc_am IS NULL) OR (cs.list_prc_am = (0)::numeric) OR (cs.sold_prc_am IS NULL)) THEN NULL::numeric
            ELSE round((((cs.sold_prc_am - cs.list_prc_am) / cs.list_prc_am) * (100)::numeric), 4)
        END AS sold_vs_list_pc,
        CASE
            WHEN ((cs.list_prc_am IS NULL) OR (cs.sold_prc_am IS NULL)) THEN NULL::text
            WHEN (cs.sold_prc_am > cs.list_prc_am) THEN 'ABOVE LIST'::text
            WHEN (cs.sold_prc_am < cs.list_prc_am) THEN 'BELOW LIST'::text
            ELSE 'AT LIST'::text
        END AS sold_vs_list_category,
    cs.sold_minus_orgnl_am AS sold_minus_original_amount_usd,
    cs.sold_to_orgnl_pc,
        CASE
            WHEN ((cs.orgnl_prc_am IS NULL) OR (cs.orgnl_prc_am = (0)::numeric) OR (cs.sold_prc_am IS NULL)) THEN NULL::numeric
            ELSE round((((cs.sold_prc_am - cs.orgnl_prc_am) / cs.orgnl_prc_am) * (100)::numeric), 4)
        END AS sold_vs_original_pc,
    cs.sold_prc_m2_am AS sold_price_per_m2_usd,
    cs.sold_prc_ft2_am AS sold_price_per_ft2_usd,
    cs.dom_nb,
    cs.pre_cnstrctn_fl,
        CASE
            WHEN cs.pre_cnstrctn_fl THEN 'PRE-CONSTRUCTION'::text
            ELSE 'RESALE'::text
        END AS market_type_nm,
    cs.extrct_rnge_id,
    cs.btch_id,
    cs.run_ts
   FROM (((dw.clsd_sale cs
     JOIN dw.lstng l ON ((l.lstng_ky = cs.lstng_ky)))
     JOIN dw.prprty p ON ((p.prprty_ky = cs.prprty_ky)))
     JOIN dw.clndr c ON ((c.clndr_ky = cs.sold_date_ky)))]]></view_script>
			<column name="clsd_sale_ky" type="bigint" />
			<column name="lstng_ky" type="bigint" />
			<column name="prprty_ky" type="bigint" />
			<column name="lstng_nb" type="bigint" />
			<column name="sold_date_ky" type="integer" />
			<column name="sold_dt" type="date" />
			<column name="sold_year_nb" type="integer" />
			<column name="sold_quarter_nb" type="integer" />
			<column name="sold_month_nb" type="integer" />
			<column name="sold_month_nm" type="text" />
