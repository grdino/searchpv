		<view name="closed_sales_mls_list" >
			<view_script><![CDATA[CREATE VIEW ${nameWithSchemaName} AS SELECT cs.clsd_sale_ky,
    cs.lstng_ky,
    l.prprty_ky,
    (l.lstng_nb)::text AS mls,
    p.zone_ds AS zone_name,
    p.area_ds AS area_name,
    p.cmnty_ds AS community_name,
    p.dvlpmnt_ds AS development,
    p.bldng_ds AS building,
    p.adrs_ds AS address,
    p.unit_id AS unit,
    l.prprty_type_cd AS property_type,
    l.bdrm_nb AS beds,
    l.full_bthrm_nb AS full_baths,
    l.half_bthrm_nb AS half_baths,
    l.m2_cnstrctn_nb AS m2,
    l.ft2_cnstrctn_nb AS ft2,
    l.m2_lot_nb AS lot_m2,
    l.ft2_lot_nb AS lot_ft2,
    l.year_blt_dt AS year_built,
    l.flr_nb AS floor,
    l.prmy_view_nm AS primary_view,
    l.scndry_view_nm AS secondary_view,
    cs.orgnl_prc_am AS orig_price,
    cs.list_prc_am AS list_price,
    cs.sold_prc_am AS sold_price,
    cs.sold_prc_ft2_am AS sold_price_ft2,
    cs.sold_prc_m2_am AS sold_price_m2,
    cs.dom_nb AS dom,
    cs.sold_date_ky,
    c.full_dt AS sold_date,
    c.year_nb AS sold_year,
    c.quarter_nb AS sold_quarter,
    c.month_nb AS sold_month,
    c.month_nm AS sold_month_name,
    c.month_abbr_nm AS sold_month_abbr,
    c.year_month_id AS sold_year_month,
    cs.pre_cnstrctn_fl AS pre_construction,
    p.lat_nb AS latitude,
    p.long_nb AS longitude,
    p.prprty_fngrprnt_id
   FROM (((dw.clsd_sale cs
     JOIN dw.lstng l ON ((l.lstng_ky = cs.lstng_ky)))
     JOIN dw.prprty p ON ((p.prprty_ky = l.prprty_ky)))
     JOIN dw.clndr c ON ((c.clndr_ky = cs.sold_date_ky)))]]></view_script>
